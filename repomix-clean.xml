import { Router } from 'express';
import { testAiService, getHaircutRecommendation } from '../controllers/recommendationController.js';
import { getClientRecommendationHistory } from '../controllers/recommendationHistoryController.js';
import { getBucketPresignedURL, getHaircutImageURL } from '../controllers/bucketController.js';

const router = Router();

/**
 * @swagger
 * /api/recommendations/test:
 *   get:
 *     summary: Verifica la conexión con el microservicio de recomendación
 *     tags: [Recommendation]
 *     description: Llama al endpoint de salud del microservicio de IA y retorna su estado.
 *     responses:
 *       200:
 *         description: Éxito. `data` contiene el estado reportado por el microservicio de IA.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 data:
 *                   type: object
 *                   properties:
 *                     status: { type: string, example: ok }
 *                 message: { type: string, example: Conexión con el servicio de recomendación exitosa }
 *                 error: { type: array, items: { type: string }, nullable: true, example: null }
 *       500:
 *         description: No fue posible conectar con el microservicio de IA.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 data: { nullable: true, example: null }
 *                 message: { type: string, example: Error al conectar con el servicio de recomendación }
 *                 error: { type: array, items: { type: string }, example: ["detalle del error"] }
 */
router.get('/recommendations/test', testAiService);

/**
 * @swagger
 * /api/recommendations/generate:
 *   post:
 *     summary: Genera recomendaciones de cortes de cabello
 *     tags: [Recommendation]
 *     description: >-
 *       Genera recomendaciones personalizadas para el cliente autenticado usando su fotografía,
 *       edad, género y preferencias. Requiere un token JWT de un cliente en el header
 *       `Authorization` (formato `Bearer <token>`).
 *
 *       **La fotografía no se envía en esta petición.** Antes de llamar a este endpoint el cliente
 *       debe haberla subido a S3 con el formulario de `GET /api/presigned-url`. El servidor deriva
 *       la key del objeto a partir del usuario autenticado (`<prefijo del bucket><id del usuario>`)
 *       y el microservicio de IA descarga la foto directamente del bucket privado. Cada usuario
 *       tiene una sola foto; subir una nueva reemplaza la anterior.
 *
 *       Si el cliente aún no tiene estructura facial registrada, esta se detecta a partir de la
 *       foto (JPEG, PNG o WEBP) antes de generar las recomendaciones; en ese caso la foto debe
 *       existir en el bucket y ser una imagen válida. La estructura facial guardada se descarta
 *       cada vez que se solicita un formulario de subida (`GET /api/presigned-url`), por lo que
 *       se vuelve a detectar con la foto nueva.
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required: [recommendationParams]
 *             properties:
 *               recommendationParams:
 *                 type: object
 *                 description: Parámetros de la recomendación. Puede enviarse vacío (`{}`); los campos no listados, como `photo`, se ignoran.
 *                 properties:
 *                   userPreferences:
 *                     type: string
 *                     maxLength: 500
 *                     description: Preferencias o indicaciones adicionales del cliente.
 *                     example: Prefiero un corte corto y fácil de mantener.
 *           example:
 *             recommendationParams:
 *               userPreferences: Prefiero un corte corto y fácil de mantener.
 *     responses:
 *       200:
 *         description: >-
 *           Respuesta válida con dos resultados posibles, que se distinguen por `data.status`:
 *
 *           - `recommended`: al menos un corte encaja con el cliente.
 *           - `no_suitable_haircut`: ninguno de los cortes existentes es compatible con las preferencias del
 *             cliente (por ejemplo, quiere cabello largo y solo hay cortes cortos). `message` es una plantilla fija
 *             que invita al cliente a hablar con su barbero y `data.reason` es el motivo redactado por la IA.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 data:
 *                   oneOf:
 *                     - type: object
 *                       description: Resultado `recommended`.
 *                       properties:
 *                         status: { type: string, enum: [recommended] }
 *                         haircuts:
 *                           type: array
 *                           items:
 *                             type: object
 *                             properties:
 *                               id: { type: string, format: uuid }
 *                               name: { type: string, example: Fade clásico }
 *                               description: { type: string, example: Degradado progresivo en los laterales. }
 *                         suggestionText: { type: string, example: Este estilo se adapta a tus características. }
 *                         reasoning: { type: string, example: El corte favorece la estructura facial y tus preferencias. }
 *                         confidence: { type: number, format: float, minimum: 0, maximum: 1, example: 0.92 }
 *                     - type: object
 *                       description: Resultado `no_suitable_haircut`.
 *                       properties:
 *                         status: { type: string, enum: [no_suitable_haircut] }
 *                         reason: { type: string, example: Buscas el cabello largo y los cortes disponibles son todos cortos. }
 *                 message:
 *                   type: string
 *                   description: >-
 *                     "Recomendación de corte generada exitosamente" con `recommended`; con `no_suitable_haircut`
 *                     es la plantilla fija sobre hablar con el barbero.
 *                   example: Recomendación de corte generada exitosamente
 *       400:
 *         description: >-
 *           Error de validación de los datos enviados (por ejemplo, `userPreferences` supera los 500 caracteres o falta
 *           `recommendationParams`) o la foto del cliente no se puede usar: no existe en el bucket o el archivo no es
 *           una imagen JPEG, PNG o WEBP válida.
 *       401:
 *         description: Token ausente, inválido o el usuario no es un cliente.
 *       404:
 *         description: No se encontró el cliente.
 *       500:
 *         description: >-
 *           Error al comunicarse con el servicio de recomendación, no hay estilos de corte disponibles
 *           o la detección de estructura facial falló por una causa ajena al cliente (por ejemplo, el
 *           almacenamiento no está disponible).
 */
router.post('/recommendations/generate', getHaircutRecommendation);

/**
 * @swagger
 * /api/recommendations:
 *   get:
 *     summary: Consulta el historial de recomendaciones de un cliente
 *     tags: [Recommendation]
 *     description: >-
 *       Devuelve las solicitudes de recomendación de un cliente, de la más reciente a la más antigua. Solo incluye
 *       las que terminaron con un resultado (`recommended` o `no_suitable_haircut`); las solicitudes que fallaron no
 *       se devuelven. Un cliente solo puede consultar su propio historial; la recepción y los gerentes pueden consultar el de
 *       cualquier cliente. Requiere un token JWT en el header `Authorization` (formato `Bearer <token>`).
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: query
 *         name: clientId
 *         required: true
 *         schema: { type: string, format: uuid }
 *         description: ID del cliente (su `user_id`).
 *     responses:
 *       200:
 *         description: Historial obtenido. `data` es un arreglo vacío si el cliente aún no ha solicitado recomendaciones.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 data:
 *                   type: array
 *                   items:
 *                     type: object
 *                     properties:
 *                       id: { type: string, format: uuid }
 *                       status:
 *                         type: string
 *                         enum: [recommended, no_suitable_haircut]
 *                         description: >-
 *                           `recommended`: la IA recomendó al menos un corte. `no_suitable_haircut`: ningún corte
 *                           aplicó (el motivo está en `reasoning`).
 *                       suggestionText: { type: string, nullable: true }
 *                       confidence: { type: number, nullable: true, minimum: 0, maximum: 100, example: 92.5 }
 *                       reasoning: { type: string, nullable: true }
 *                       recommendedHaircuts:
 *                         type: array
 *                         description: >-
 *                           Cortes recomendados, en el orden de la IA (el primero es el mejor). Vacío si ningún corte
 *                           aplicó o los cortes recomendados fueron eliminados.
 *                         items:
 *                           type: object
 *                           properties:
 *                             id: { type: string, format: uuid }
 *                             name: { type: string, example: EVA Pilot Crop }
 *                       requestedAt: { type: string, format: date-time }
 *                       completedAt: { type: string, format: date-time, nullable: true }
 *                 message: { type: string, example: Recommendation history retrieved successfully }
 *       400:
 *         description: Falta `clientId` o no es un UUID válido, o el token tiene un formato inválido.
 *       401:
 *         description: Token ausente o inválido.
 *       403:
 *         description: La cuenta está desactivada, o un cliente intenta consultar el historial de otro cliente.
 *       404:
 *         description: No se encontró el cliente.
 */
router.get('/recommendations', getClientRecommendationHistory);

/**
 * @swagger
 * /api/presigned-url:
 *   get:
 *     summary: Genera un formulario presignado para subir una imagen
 *     tags: [Storage]
 *     description: Genera una URL y los campos necesarios para subir una imagen directamente a S3. La carga debe enviarse como multipart/form-data, incluir todos los campos retornados y declarar un Content-Type que comience con image/. El archivo no puede superar los 5 MB.
 *     security:
 *       - bearerAuth: []
 *     responses:
 *       200:
 *         description: Formulario presignado generado exitosamente.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               required: [data, message]
 *               properties:
 *                 data:
 *                   type: object
 *                   required: [url, fields]
 *                   properties:
 *                     url:
 *                       type: string
 *                       format: uri
 *                       description: URL de S3 a la que debe enviarse el formulario multipart.
 *                     fields:
 *                       type: object
 *                       additionalProperties:
 *                         type: string
 *                       description: Campos firmados que deben incluirse sin modificaciones en el formulario.
 *                 message:
 *                   type: string
 *                   example: Presigned URL generated successfully
 *       401:
 *         description: Token ausente, inválido o el usuario no es un cliente.
 *       502:
 *         description: No se pudieron resolver las credenciales de AWS.
 *       500:
 *         description: Error inesperado al generar el formulario presignado.
 */
router.get('/presigned-url', getBucketPresignedURL);

/**
 * @swagger
 * /api/haircuts/{haircutId}/image-url:
 *   get:
 *     summary: Genera una URL presignada para ver la foto de un corte de cabello
 *     tags: [Storage]
 *     description: >-
 *       Devuelve una URL presignada (GET) de corta duración para mostrar la foto de catálogo de un corte.
 *       Es pública: no requiere token. La foto se busca en el bucket por el nombre del corte en snake_case
 *       (por ejemplo, "Wolf Cut" -> `wolf_cut`) con extensión jpg, png o webp.
 *     parameters:
 *       - in: path
 *         name: haircutId
 *         required: true
 *         schema: { type: string, format: uuid }
 *         description: ID del estilo de corte.
 *     responses:
 *       200:
 *         description: URL generada exitosamente.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               required: [data, message]
 *               properties:
 *                 data:
 *                   type: object
 *                   required: [url, expiresIn]
 *                   properties:
 *                     url: { type: string, format: uri, description: URL presignada de la imagen. }
 *                     expiresIn: { type: integer, description: Segundos de vigencia de la URL., example: 300 }
 *                 message: { type: string, example: Haircut image URL generated successfully }
 *       400:
 *         description: haircutId no es un UUID válido.
 *       404:
 *         description: No existe el corte o no hay una imagen para él en el bucket.
 *       502:
 *         description: No se pudieron resolver las credenciales de AWS.

<file path="backend/src/utils/businessTime.ts">
import globalConfig from '../config/globalConfig.js';

const formatters = new Map<string, Intl.DateTimeFormat>();

const getFormatter = (timeZone: string): Intl.DateTimeFormat => {
    let formatter = formatters.get(timeZone);
    if (!formatter) {
        // Lanza RangeError si la zona no es válida: preferimos fallar fuerte a calcular mal "hoy".
        formatter = new Intl.DateTimeFormat('en-US', {
            timeZone,
            hourCycle: 'h23',
            year: 'numeric',
            month: 'numeric',
            day: 'numeric',
            hour: 'numeric',
            minute: 'numeric',
            second: 'numeric',
        });
        formatters.set(timeZone, formatter);
    }
    return formatter;
};

/** Zona horaria del negocio (se lee en cada llamada para poder sobreescribirla en pruebas). */
export const getBusinessTimezone = (): string => globalConfig.BUSINESS_TIMEZONE;

/**
 * Hora de pared del negocio expresada como ms "en UTC": el resultado, leído con los
 * getters UTC, muestra la fecha y hora que marca el reloj en `timeZone`. Es la misma
 * convención que usa el servicio de disponibilidad (turnos y horarios como hora de pared).
 */
export const toBusinessWallClockMs = (utcMs: number = Date.now(), timeZone: string = getBusinessTimezone()): number => {
    const parts: Record<string, number> = {};
    for (const { type, value } of getFormatter(timeZone).formatToParts(new Date(utcMs))) {
        if (type !== 'literal') parts[type] = Number(value);
    }
    const millis = ((utcMs % 1000) + 1000) % 1000;
    return Date.UTC(parts.year, parts.month - 1, parts.day, parts.hour, parts.minute, parts.second, millis);
};

/**
 * Inversa de toBusinessWallClockMs: dado un instante expresado como "hora de pared ficticia en UTC"
 * (p. ej. el que arma parseDate, o dayStart + minutos dentro de availabilityService), devuelve el
 * instante real (UTC) cuyo reloj de pared en `timeZone` marca esa fecha y hora. Itera dos veces para
 * acertar también justo en una transición de horario de verano (el primer intento puede caer del lado
 * equivocado del cambio).
 */
export const businessWallClockToUtcMs = (
    wallClockFakeUtcMs: number,
    timeZone: string = getBusinessTimezone()
): number => {
    let instantMs = wallClockFakeUtcMs;
    for (let i = 0; i < 2; i++) {
        instantMs = wallClockFakeUtcMs - (toBusinessWallClockMs(instantMs, timeZone) - instantMs);
    }
    return instantMs;
};

/** 'HH:MM[:SS]' (columna time de Postgres) -> minutos desde medianoche. */
export const timeToMinutes = (time: string): number => {
    const [h, m] = time.split(':').map(Number);
    return h * 60 + m;
};

/** Fecha de hoy ('YYYY-MM-DD') en la zona horaria del negocio. */
export const getBusinessToday = (utcMs: number = Date.now(), timeZone: string = getBusinessTimezone()): string =>
    new Date(toBusinessWallClockMs(utcMs, timeZone)).toISOString().slice(0, 10);

/**
 * Instante real (UTC) en que empieza, a las 00:00 de la zona horaria del negocio, el día que está
 * `daysFromToday` días después de hoy (0 = hoy). Parte de la hora de pared deseada y le resta el
 * desfase de la zona; el desfase se vuelve a calcular una vez para acertar en zonas con horario de verano.
 */
export const getBusinessDayStart = (
    daysFromToday: number = 0,
    utcMs: number = Date.now(),
    timeZone: string = getBusinessTimezone()
): Date => {
    const todayWallMs = Date.parse(`${getBusinessToday(utcMs, timeZone)}T00:00:00.000Z`);
    const targetWallMs = todayWallMs + daysFromToday * 24 * 60 * 60 * 1000;
    return new Date(businessWallClockToUtcMs(targetWallMs, timeZone));
};
</file>

<file path="backend/src/utils/dateOnly.ts">
import { z } from 'zod';

/* Una fecha de calendario (p. ej. birth_date, columna DATE) no tiene hora ni zona horaria.
   Se maneja siempre como string 'YYYY-MM-DD' para evitar corrimientos de día al convertir
   a/desde Date (que siempre implica un instante y una zona). */

const DATE_ONLY_REGEX = /^(\d{4})-(\d{2})-(\d{2})(?:T[\d:.]*)?$/;

const isRealCalendarDate = (year: number, month: number, day: number): boolean => {
    const d = new Date(Date.UTC(year, month - 1, day));
    return d.getUTCFullYear() === year && d.getUTCMonth() === month - 1 && d.getUTCDate() === day;
};

/**
 * Acepta 'YYYY-MM-DD'. Por compatibilidad con clientes que envían 'YYYY-MM-DDTHH:mm:ss' SIN zona
 * (p. ej. Android), descarta la parte de hora. Cualquier otro formato (incluido uno con 'Z' u
 * offset, que sí representa un instante) se rechaza. Devuelve el string 'YYYY-MM-DD'.
 */
export const dateOnlySchema = z
    .string()
    .trim()
    .transform((value, ctx) => {
        const match = DATE_ONLY_REGEX.exec(value);
        if (!match || !isRealCalendarDate(Number(match[1]), Number(match[2]), Number(match[3]))) {
            ctx.addIssue({ code: 'custom', message: 'Format must be YYYY-MM-DD' });
            return z.NEVER;
        }
        return `${match[1]}-${match[2]}-${match[3]}`;
    });

/** Edad en años cumplidos a partir de 'YYYY-MM-DD', comparando contra la fecha local de hoy. */
export const calculateAgeFromDateOnly = (birthDate: string, today = new Date()): number => {
    const [year, month, day] = birthDate.slice(0, 10).split('-').map(Number);
    let age = today.getFullYear() - year;
    const birthdayHasOccurred =
        today.getMonth() + 1 > month || (today.getMonth() + 1 === month && today.getDate() >= day);
    if (!birthdayHasOccurred) age -= 1;
    return age;
};
</file>


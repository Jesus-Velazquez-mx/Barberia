import { Router } from 'express';
import { list, getById, create, update, remove } from '../controllers/shopController.js';
import { listByShop } from '../controllers/barberController.js';
import { listByShop as listReceptionistsByShop } from '../controllers/receptionistController.js';
import { getAvailability, getNextAvailability } from '../controllers/availabilitySlotController.js';

const router = Router();

/**
 * @swagger
 * /api/shops:
 *   get:
 *     summary: Obtiene la lista de sucursales
 *     tags: [Shops]
 *     description: Retorna un listado con las sucursales ordenadas alfabéticamente. Por defecto devuelve solo las activas. Si se incluye el parámetro `includeInactive=true`, retorna todas las sucursales.
 *     parameters:
 *       - in: query
 *         name: includeInactive
 *         required: false
 *         schema:
 *           type: boolean
 *           example: false
 *         description: Si es true, incluye sucursales inactivas en el listado.
 *     responses:
 *       200:
 *         description: Éxito. `data` contiene el arreglo de sucursales.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 data:
 *                   type: array
 *                   items:
 *                     type: object
 *                     properties:
 *                       id: { type: string, format: uuid }
 *                       name: { type: string }
 *                       street: { type: string, nullable: true }
 *                       postalCode: { type: string, nullable: true }
 *                       number: { type: string, nullable: true }
 *                       phone: { type: string, nullable: true }
 *                       isActive: { type: boolean }
 *                       createdAt: { type: string, format: date-time }
 *                       updatedAt: { type: string, format: date-time }
 *                 message: { type: string, example: Active shops retrieved successfully }
 *                 error: { nullable: true, example: null }
 *       500:
 *         description: Error interno del servidor.
 */
router.get('/shops', list);

/**
 * @swagger
 * /api/shops:
 *   post:
 *     summary: Registra una nueva sucursal
 *     tags: [Shops]
 *     description: Permite a un administrador o manager registrar una nueva sucursal en el sistema. Requiere token JWT en el header `Authorization`.
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required: [name]
 *             properties:
 *               name:
 *                 type: string
 *                 maxLength: 50
 *                 example: Sucursal Centro
 *               street:
 *                 type: string
 *                 maxLength: 50
 *                 nullable: true
 *                 example: Av. Hidalgo
 *               postalCode:
 *                 type: string
 *                 minLength: 5
 *                 maxLength: 5
 *                 nullable: true
 *                 example: "44100"
 *               number:
 *                 type: string
 *                 maxLength: 4
 *                 nullable: true
 *                 example: "123"
 *               phone:
 *                 type: string
 *                 minLength: 10
 *                 maxLength: 10
 *                 nullable: true
 *                 example: "3312345678"
 *               managerId:
 *                 type: string
 *                 format: uuid
 *                 description: ID del manager asignado. Si se omite, se asigna el manager del token.
 *               isActive:
 *                 type: boolean
 *                 default: true
 *     responses:
 *       201:
 *         description: Sucursal creada exitosamente.
 *       400:
 *         description: Error de validación en los campos proporcionados.
 *       401:
 *         description: Token ausente o inválido.
 *       403:
 *         description: Prohibido. El usuario no tiene rol de manager o su cuenta está desactivada.
 *       404:
 *         description: El manager asignado no existe o está desactivado.
 *       409:
 *         description: El nombre de la sucursal ya se encuentra en uso.
 *       500:
 *         description: Error interno del servidor.
 */
router.post('/shops', create);

/**
 * @swagger
 * /api/shops/{id}:
 *   get:
 *     summary: Obtiene los detalles de una sucursal específica
 *     tags: [Shops]
 *     description: Recupera la información de una sucursal activa según su ID. Si la sucursal está inactiva o no existe, retorna 404. Endpoint público.
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID único de la sucursal.
 *     responses:
 *       200:
 *         description: Éxito. `data` contiene la información de la sucursal.
 *       400:
 *         description: Error de validación (el ID no es un UUID válido).
 *       404:
 *         description: Sucursal no encontrada o inactiva.
 *       500:
 *         description: Error interno del servidor.
 */
router.get('/shops/:id', getById);

/**
 * @swagger
 * /api/shops/{id}:
 *   put:
 *     summary: Edita una sucursal existente
 *     tags: [Shops]
 *     description: Actualiza los campos especificados de una sucursal. Requiere token de manager.
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID único de la sucursal a editar.
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               name:
 *                 type: string
 *                 maxLength: 50
 *               street:
 *                 type: string
 *                 maxLength: 50
 *                 nullable: true
 *               postalCode:
 *                 type: string
 *                 minLength: 5
 *                 maxLength: 5
 *                 nullable: true
 *               number:
 *                 type: string
 *                 maxLength: 4
 *                 nullable: true
 *               phone:
 *                 type: string
 *                 minLength: 10
 *                 maxLength: 10
 *                 nullable: true
 *               managerId:
 *                 type: string
 *                 format: uuid
 *               isActive:
 *                 type: boolean
 *     responses:
 *       200:
 *         description: Sucursal actualizada correctamente.
 *       400:
 *         description: Error de validación o ningún campo proporcionado.
 *       401:
 *         description: Token ausente o inválido.
 *       403:
 *         description: No autorizado.
 *       404:
 *         description: Sucursal o manager asignado no encontrado.
 *       409:
 *         description: El nombre de la sucursal ya pertenece a otra tienda.
 *       500:
 *         description: Error interno del servidor.
 */
router.put('/shops/:id', update);

/**
 * @swagger
 * /api/shops/{id}:
 *   delete:
 *     summary: Elimina lógicamente una sucursal
 *     tags: [Shops]
 *     description: Realiza un borrado lógico de la sucursal estableciendo su campo `is_active` en false. No elimina físicamente la fila en base de datos para preservar la integridad de datos históricos. Requiere token de manager.
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID único de la sucursal a eliminar.
 *     responses:
 *       200:
 *         description: Sucursal eliminada lógicamente con éxito.
 *       400:
 *         description: Error de validación (ID no es UUID válido).
 *       401:
 *         description: Token ausente o inválido.
 *       403:
 *         description: No autorizado.
 *       404:
 *         description: Sucursal no encontrada.
 *       500:
 *         description: Error interno del servidor.
 */
router.delete('/shops/:id', remove);

/**
 * @swagger
 * /api/shops/{id}/barbers:
 *   get:
 *     summary: Obtiene los barberos disponibles en una sucursal específica
 *     tags: [Shops, Barbers]
 *     description: Endpoint público (el token JWT es opcional). Los datos devueltos dependen del rol del solicitante. Usuarios no registrados y clientes reciben solo la vista pública (`id`, `firstName`, `lastName`, `shopId`, `shiftId`, `bio`) de los barberos que no están dados de baja y aceptan reservas. El personal (gerentes y recepcionistas) recibe el perfil completo (además `email`, `phone`, `birthDate`, `gender`, `isAcceptingBookings`, `deletedAt`, `createdAt`, `updatedAt`) de todos los barberos no dados de baja, incluidos los que no aceptan reservas; con `includeInactive=true` también los dados de baja. `includeInactive` se ignora para quien no sea personal.
 *     security:
 *       - {}
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID único de la sucursal.
 *       - in: query
 *         name: includeInactive
 *         required: false
 *         schema:
 *           type: boolean
 *           default: false
 *         description: Solo personal. Si es `true`, incluye también a los barberos dados de baja.
 *     responses:
 *       200:
 *         description: Éxito. `data` contiene el arreglo de barberos (puede estar vacío `[]` si la sucursal existe pero no tiene barberos). Los campos "solo personal" únicamente se incluyen para gerentes y recepcionistas.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 data:
 *                   type: array
 *                   items:
 *                     type: object
 *                     properties:
 *                       id: { type: string, format: uuid }
 *                       firstName: { type: string, example: "Juan" }
 *                       lastName: { type: string, example: "Pérez" }
 *                       shopId: { type: string, format: uuid }
 *                       shiftId: { type: string, format: uuid }
 *                       bio: { type: string, nullable: true }
 *                       email: { type: string, format: email, nullable: true, description: Solo personal }
 *                       phone: { type: string, nullable: true, description: Solo personal }
 *                       birthDate: { type: string, format: date, description: Solo personal }
 *                       gender: { type: string, description: Solo personal }
 *                       isAcceptingBookings: { type: boolean, description: Solo personal }
 *                       deletedAt: { type: string, format: date-time, nullable: true, description: Solo personal }
 *                       createdAt: { type: string, format: date-time, description: Solo personal }
 *                       updatedAt: { type: string, format: date-time, description: Solo personal }
 *                 message: { type: string, example: Barbers retrieved successfully }
 *                 error: { type: array, items: { type: string }, nullable: true, example: null }
 *       400:
 *         description: Error de validación (el ID no es un UUID válido).
 *       401:
 *         description: Se envió un token JWT inválido o expirado.
 *       404:
 *         description: La sucursal especificada no existe.
 *       500:
 *         description: Error interno del servidor.
 */
router.get('/shops/:id/barbers', listByShop);

/**
 * @swagger
 * /api/shops/{id}/receptionists:
 *   get:
 *     summary: Obtiene los recepcionistas de una sucursal
 *     tags: [Shops, Receptionists]
 *     security:
 *       - bearerAuth: []
 *     description: Retorna los recepcionistas no dados de baja de la sucursal, ordenados por nombre; con `includeInactive=true` también los dados de baja. Requiere rol de 'manager' y que la sucursal sea una que el gerente administra. Una sucursal sin recepcionistas devuelve un arreglo vacío.
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID único de la sucursal.
 *       - in: query
 *         name: includeInactive
 *         required: false
 *         schema:
 *           type: boolean
 *           default: false
 *         description: Si es `true`, incluye también a los recepcionistas dados de baja.
 *     responses:
 *       200:
 *         description: Éxito. `data` contiene el arreglo de recepcionistas (puede estar vacío `[]`).
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 data:
 *                   type: array
 *                   items:
 *                     type: object
 *                     properties:
 *                       userId: { type: string, format: uuid }
 *                       shopId: { type: string, format: uuid }
 *                       shiftId: { type: string, format: uuid }
 *                       firstName: { type: string, example: "Misato" }
 *                       lastName: { type: string, example: "Katsuragi" }
 *                       email: { type: string, format: email }
 *                       phone: { type: string, nullable: true }
 *                       birthDate: { type: string, format: date }
 *                       gender: { type: string }
 *                       deletedAt: { type: string, format: date-time, nullable: true }
 *                       createdAt: { type: string, format: date-time }
 *                       updatedAt: { type: string, format: date-time }
 *                 message: { type: string, example: Receptionists retrieved successfully }
 *                 error: { type: array, items: { type: string }, nullable: true, example: null }
 *       400:
 *         description: Error de validación (el ID no es un UUID válido).
 *       401:
 *         description: No autorizado.
 *       403:
 *         description: Prohibido. Solo un manager puede consultar recepcionistas y únicamente los de sus sucursales.
 *       404:
 *         description: La sucursal especificada no existe.
 *       500:
 *         description: Error interno del servidor.
 */
router.get('/shops/:id/receptionists', listReceptionistsByShop);

/**
 * @swagger
 * /api/shops/{id}/availability:
 *   get:
 *     summary: Consulta los horarios disponibles por barbero para una sucursal, fecha y servicios
 *     tags: [Shops, Availability, Appointments]
 *     description: |
 *       Calcula los horarios de inicio agendables por cada barbero elegible de la sucursal para uno o más servicios en una fecha determinada;
 *       la duración considerada es la suma de las duraciones de los servicios.
 *       **Sin `excludeAppointmentId`**: endpoint público, no requiere token JWT.
 *       **Con `excludeAppointmentId`**: la cita indicada se excluye del cálculo de ocupación, mostrando los horarios que estarían libres si esa
 *       cita se moviera. Esto permite reagendar una cita sin que su propio horario actual la bloquee. En este modo:
 *       - Se **exige** token JWT (sin token → 401).
 *       - La cita debe existir (si no → 404).
 *       - Se valida que el solicitante tenga permiso para editar esa cita, con las mismas reglas de alcance por rol que `PUT /api/appointments/{id}`:
 *         client solo su propia cita; receptionist solo citas de su sucursal; manager solo citas de las sucursales que administra (sin permiso → 403).
 *       - La cita debe pertenecer a la sucursal `{id}` (si no → 422). Esta validación ocurre después de la de permiso, para no revelar
 *         a qué sucursal pertenece una cita ajena.
 *
 *       Con `excludeAppointmentId` este endpoint solo garantiza la **ocupación**: los horarios devueltos no chocan con ninguna otra cita
 *       del barbero, con las mismas reglas que usa `PUT /api/appointments/{id}` para la misma cita, barbero y servicios. **No** valida las
 *       demás reglas de edición del PUT, que puede rechazar un horario devuelto aquí cuando:
 *       - la cita no está en `scheduled` o `rescheduled`, o ya empezó (409);
 *       - el solicitante es client y faltan menos de 8 horas para la cita (403);
 *       - la nueva fecha cae más de 30 días después de la fecha en que se agendó la cita (422).
 *     security:
 *       - {}
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID único de la sucursal.
 *       - in: query
 *         name: date
 *         required: true
 *         schema:
 *           type: string
 *           format: date
 *           example: "2026-10-15"
 *         description: Fecha a consultar en formato YYYY-MM-DD (no puede ser anterior a hoy).
 *       - in: query
 *         name: serviceIds
 *         required: true
 *         style: form
 *         explode: true
 *         schema:
 *           type: array
 *           items:
 *             type: string
 *             format: uuid
 *         description: IDs de los servicios que se desean agendar, sin repetir. Se repite el parámetro (?serviceIds=a&serviceIds=b) o se separan por comas (?serviceIds=a,b).
 *       - in: query
 *         name: excludeAppointmentId
 *         required: false
 *         schema:
 *           type: string
 *           format: uuid
 *         description: |
 *           ID de la cita que se está reagendando. Si se envía, esa cita no cuenta como ocupada al calcular
 *           la disponibilidad. Requiere token JWT; sin token responde 401. El solicitante debe poder editar
 *           la cita (mismas reglas de alcance que `PUT /api/appointments/{id}`); sin permiso responde 403.
 *           La cita debe existir (404) y pertenecer a la sucursal `{id}` (422).
 *     responses:
 *       200:
 *         description: Éxito. Retorna los slots de inicio disponibles agrupados por barbero.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 data:
 *                   type: array
 *                   items:
 *                     type: object
 *                     properties:
 *                       barberId:
 *                         type: string
 *                         format: uuid
 *                       startTimes:
 *                         type: array
 *                         items:
 *                           type: string
 *                           format: date-time
 *                 message:
 *                   type: string
 *                   example: Available slots retrieved successfully
 *                 error:
 *                   nullable: true
 *                   example: null
 *       400:
 *         description: Error de validación (fecha inválida o pasada, serviceIds faltante, inválido o con repetidos, id de sucursal inválido, excludeAppointmentId no es UUID).
 *       401:
 *         description: Token ausente o inválido. Se requiere cuando se envía `excludeAppointmentId`.
 *       403:
 *         description: El solicitante no tiene permiso para editar la cita indicada en `excludeAppointmentId`.
 *       404:
 *         description: Sucursal no encontrada/inactiva, algún servicio no encontrado/inactivo, o la cita indicada en `excludeAppointmentId` no existe.
 *       422:
 *         description: La cita indicada en `excludeAppointmentId` no pertenece a la sucursal `{id}`.
 *       500:
 *         description: Error interno del servidor.
 */
router.get('/shops/:id/availability', getAvailability);

/**
 * @swagger
 * /api/shops/{id}/availability/next:
 *   get:
 *     summary: Consulta el próximo slot disponible de hoy de cada barbero de la sucursal (apoyo al walk-in)
 *     tags: [Shops, Availability, Appointments]
 *     description: |
 *       Apoya el flujo "Registrar servicio sin cita": devuelve el slot disponible más próximo de **cada** barbero de la sucursal
 *       que pueda dar los servicios indicados, ordenado por `startTime` ascendente. No hay desempate automático: el staff comunica
 *       las opciones al cliente y éste elige barbero y hora.
 *       - Solo se consideran slots del **día actual** (zona horaria del negocio, `BUSINESS_TIMEZONE`); no se devuelven horas ya pasadas.
 *       - Se calcula con las mismas reglas que `GET /api/shops/{id}/availability` (turno del barbero, `is_accepting_bookings`,
 *         días abiertos lunes a sábado y citas `scheduled`, `rescheduled` y `checked_in`); cada `startTime` es el primero de los
 *         `startTimes` que ese endpoint devuelve hoy para el barbero, por lo que es aceptado por `POST /api/appointments` con ese
 *         barbero y esos mismos servicios.
 *       - **Barbero sin slot restante hoy: se omite de la lista.** Si a ningún barbero le queda disponibilidad hoy (p. ej. domingo
 *         o ya terminaron los turnos), responde 200 con una lista vacía.
 *       - Solo personal de la sucursal: el recepcionista que trabaja en ella o el manager que la administra.
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID único de la sucursal.
 *       - in: query
 *         name: serviceIds
 *         required: true
 *         style: form
 *         explode: true
 *         schema:
 *           type: array
 *           items:
 *             type: string
 *             format: uuid
 *         description: IDs de los servicios del walk-in, sin repetir. Se repite el parámetro (?serviceIds=a&serviceIds=b) o se separan por comas (?serviceIds=a,b).
 *     responses:
 *       200:
 *         description: Éxito. Retorna el próximo slot de hoy por barbero, ordenado por hora; lista vacía si no queda disponibilidad hoy.
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 data:
 *                   type: array
 *                   items:
 *                     type: object
 *                     properties:
 *                       barberId:
 *                         type: string
 *                         format: uuid
 *                       barberName:
 *                         type: string
 *                         example: Juan Pérez
 *                       startTime:
 *                         type: string
 *                         format: date-time
 *                 message:
 *                   type: string
 *                   example: Next available slots retrieved successfully
 *                 error:
 *                   nullable: true
 *                   example: null
 *       400:
 *         description: Error de validación (id de sucursal inválido, serviceIds faltante, inválido o con repetidos).
 *       401:
 *         description: Token ausente o inválido.
 *       403:
 *         description: El solicitante es cliente, o es personal de otra sucursal.
 *       404:
 *         description: Sucursal no encontrada/inactiva, o algún servicio no encontrado/inactivo.
 *       500:
 *         description: Error interno del servidor.
 */
router.get('/shops/:id/availability/next', getNextAvailability);

export default router;
</file>

<file path="backend/src/services/receptionistService.ts">
import bcrypt from 'bcrypt';
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import { decodeToken } from './jwtTokenService.js';
import {
    getReceptionistWithUserById,
    getReceptionistsByShop,
    createReceptionist,
    reactivateReceptionist,
    updateReceptionistAssignment,
    type CreateReceptionistInput,
} from '../repositories/receptionistRepository.js';
import { getUserByEmail, isUserActive, softDeleteStaff, updateUserById } from '../repositories/userRepository.js';
import { getShopById, getShopIdsByManagerId } from '../repositories/shopRepository.js';
import { getShiftById } from '../repositories/shiftRepository.js';
import type { ReceptionistDetailResponse } from '../types/dto/receptionistResponse.interface.js';
import { toReceptionistDetailResponse } from '../utils/receptionistMapper.js';
import { canManageReceptionists, canManageShopReceptionists } from './userPermissions.js';

export interface RegisterReceptionistInput {
    firstName: string;
    lastName: string;
    email: string;
    phone?: string | null;
    birthDate: string;
    gender: string;
    password: string;
    shopId: string;
    shiftId: string;
}

export interface UpdateReceptionistInput {
    id: string;
    firstName?: string;
    lastName?: string;
    email?: string;
    phone?: string;
    birthDate?: string;
    gender?: string;
}

export interface ReassignReceptionistInput {
    shopId: string;
    shiftId: string;
}

/**
 * Valida que quien ejecuta la acción sea un gerente activo y devuelve los IDs de las sucursales que administra.
 * Un gerente solo puede gestionar a los recepcionistas de esas sucursales.
 */
const authorizeManager = async (token: string, forbiddenMessage: string): Promise<string[]> => {
    const performer = decodeToken(token);

    if (!canManageReceptionists(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, forbiddenMessage);
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    return getShopIdsByManagerId(performer.id);
};

const assertShopManaged = (shopId: string, managedShopIds: string[]): void => {
    if (!canManageShopReceptionists(shopId, managedShopIds)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to manage receptionists of this shop');
    }
};

/**
 * Obtiene el detalle de un recepcionista (incluso dado de baja) de una sucursal que administra el gerente.
 */
export const getReceptionistDetails = async (id: string, token: string): Promise<ReceptionistDetailResponse> => {
    const managedShopIds = await authorizeManager(token, 'Not authorized to view this receptionist');

    const receptionist = await getReceptionistWithUserById(id);
    if (!receptionist) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Receptionist not found');
    }
    assertShopManaged(receptionist.shop_id, managedShopIds);

    return toReceptionistDetailResponse(receptionist);
};

/**
 * Lista los recepcionistas de una sucursal que administra el gerente. Por defecto excluye a los dados de baja;
 * con includeInactive también los incluye. Una sucursal sin recepcionistas devuelve un arreglo vacío.
 */
export const listReceptionistsByShop = async (
    shopId: string,
    token: string,
    includeInactive = false
): Promise<ReceptionistDetailResponse[]> => {
    const managedShopIds = await authorizeManager(token, 'Not authorized to view receptionists');

    const shop = await getShopById(shopId);
    if (!shop) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shop not found');
    }
    assertShopManaged(shopId, managedShopIds);

    const receptionists = await getReceptionistsByShop(shopId, includeInactive);
    return receptionists.map(toReceptionistDetailResponse);
};

/**
 * Registra un nuevo recepcionista o reactiva uno dado de baja si el correo coincide.
 */
export const registerReceptionist = async (
    data: RegisterReceptionistInput,
    token: string
): Promise<ReceptionistDetailResponse> => {
    const managedShopIds = await authorizeManager(token, 'Not authorized to create a receptionist');

    const shop = await getShopById(data.shopId);
    if (!shop) throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shop not found');

    const shift = await getShiftById(data.shiftId);
    if (!shift) throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shift not found');

    assertShopManaged(data.shopId, managedShopIds);

    const input: CreateReceptionistInput = {
        email: data.email,
        phone: data.phone ?? null,
        passwordHash: await bcrypt.hash(data.password, 10),
        firstName: data.firstName,
        lastName: data.lastName,
        birthDate: data.birthDate,
        gender: data.gender,
        shopId: data.shopId,
        shiftId: data.shiftId,
    };

    // El correo es único en toda la tabla users: solo un recepcionista dado de baja puede reactivarse con él.
    const existingUser = await getUserByEmail(data.email);

    if (existingUser) {
        if (existingUser.role !== 'receptionist') {
            throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Email is already registered');
        }

        const existingReceptionist = await getReceptionistWithUserById(existingUser.id);
        if (existingReceptionist && existingReceptionist.deleted_at === null) {
            throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Email already in use by an active receptionist');
        }

        const reactivated = await reactivateReceptionist(existingUser.id, input);
        return toReceptionistDetailResponse(reactivated);
    }

    const created = await createReceptionist(input);
    return toReceptionistDetailResponse(created);
};

/**
 * Actualiza los datos personales del recepcionista objetivo. La sucursal y el turno no se modifican aquí.
 */
export const updateReceptionist = async (
    target: UpdateReceptionistInput,
    token: string
): Promise<ReceptionistDetailResponse> => {
    const managedShopIds = await authorizeManager(token, 'Not authorized to update this receptionist');

    const receptionist = await getReceptionistWithUserById(target.id);
    if (!receptionist) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Receptionist not found');
    }
    assertShopManaged(receptionist.shop_id, managedShopIds);

    if (receptionist.deleted_at !== null) {
        throw new ApiError(
            ApiErrorCode.CONFLICT,
            'Receptionist has been deleted. Reactivation is needed to modify receptionist data'
        );
    }

    // updateUserById valida que correo y teléfono no pertenezcan a otro usuario (409)
    await updateUserById({
        id: target.id,
        firstName: target.firstName,
        lastName: target.lastName,
        email: target.email,
        phone: target.phone,
        birthDate: target.birthDate,
        gender: target.gender,
    });

    const updated = await getReceptionistWithUserById(target.id);
    if (!updated) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Receptionist not found');
    }
    return toReceptionistDetailResponse(updated);
};

/**
 * Da de baja lógicamente al recepcionista objetivo.
 */
export const deleteReceptionist = async (targetId: string, token: string): Promise<void> => {
    const managedShopIds = await authorizeManager(token, 'Not authorized to delete this receptionist');

    const receptionist = await getReceptionistWithUserById(targetId);
    if (!receptionist) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Receptionist not found');
    }
    assertShopManaged(receptionist.shop_id, managedShopIds);

    // Ya dado de baja: no-op, para no sobrescribir la fecha original de deleted_at (igual que deleteBarber)
    if (receptionist.deleted_at !== null) return;

    await softDeleteStaff(targetId, 'receptionist');
};

/**
 * Reasigna la sucursal y el turno de un recepcionista.
 * Solo un manager puede usarlo, y debe administrar tanto la sucursal actual como la nueva.
 * Responder 404 si la sucursal o el turno no existen, y 409 si el integrante está dado de baja.
 */
export const reassignReceptionist = async (
    targetId: string,
    assignment: ReassignReceptionistInput,
    token: string
): Promise<ReceptionistDetailResponse> => {
    const managedShopIds = await authorizeManager(token, 'Not authorized to reassign receptionists');

    const receptionist = await getReceptionistWithUserById(targetId);
    if (!receptionist) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Receptionist not found');
    }

    // Origen debe ser administrado por el manager
    assertShopManaged(receptionist.shop_id, managedShopIds);

    if (receptionist.deleted_at !== null) {
        throw new ApiError(
            ApiErrorCode.CONFLICT,
            'Receptionist has been deleted. Reactivation is needed to modify receptionist data'
        );
    }

    const destinationShop = await getShopById(assignment.shopId);
    if (!destinationShop) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shop not found');
    }

    const shift = await getShiftById(assignment.shiftId);
    if (!shift) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shift not found');
    }

    // Destino debe ser administrado por el manager
    assertShopManaged(assignment.shopId, managedShopIds);

    const updated = await updateReceptionistAssignment(targetId, assignment.shopId, assignment.shiftId);
    return toReceptionistDetailResponse(updated);
};
</file>

<file path="backend/src/jobs/index.ts">
import connection from '../connection/connection.js';
import { createJobRunner, type JobRunner } from './jobRunner.js';
import { walkInCheckInJob } from './walkInCheckInJob.js';
import { noShowJob } from './noShowJob.js';
import { reminderJob } from './reminderJob.js';
import type { JobGroup } from './types.js';
import { completeAppointmentsJob } from './completeAppointmentsJob.js';

/** Claves de `pg_try_advisory_lock`, una por grupo. No reutilizar ni cambiar sin coordinar despliegues. */
export const JOB_LOCK_KEYS = {
    appointmentStatus: 252_001,
    appointmentReminders: 252_002,
} as const;

export interface JobsConfig {
    JOBS_INTERVAL_MS: number;
    REMINDERS_JOB_INTERVAL_MS: number;
}

export const buildJobGroups = (config: JobsConfig): JobGroup[] => [
    {
        name: 'appointment-status',
        intervalMs: config.JOBS_INTERVAL_MS,
        lockKey: JOB_LOCK_KEYS.appointmentStatus,
        /*
         * El orden es obligatorio (R-WI-7): tras una caída del servidor, un walk-in cuyo scheduled_end ya
         * pasó debe quedar checked_in y luego completed en la misma corrida.
         *   1) auto check-in de walk-ins  (#258)
         *   2) completar citas            (#253)
         *   3) marcar no-show             (#254)
         * Cada job debe ser un UPDATE atómico e idempotente que use `ctx.now` (no `now()` de SQL).
         */
        jobs: [walkInCheckInJob,completeAppointmentsJob, noShowJob],
    },
    {
        name: 'appointment-reminders',
        intervalMs: config.REMINDERS_JOB_INTERVAL_MS,
        lockKey: JOB_LOCK_KEYS.appointmentReminders,
        jobs: [reminderJob],
    },
];

export const createAppJobRunner = (config: JobsConfig): JobRunner =>
    createJobRunner({ groups: buildJobGroups(config), getPool: connection.getPool });
</file>

<file path="backend/src/repositories/clientRepository.ts">
import type { Pool, PoolClient } from 'pg';
import db from '../connection/connection.js';
import type { AppointmentClient } from '../types/dto/appointmentResponse.interface.js';
import type { Client, FacialStructureType } from '../types/entities/client.interface.js';
import type { UserRole } from '../types/entities/user.interface.js';
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';

export interface CreateClientRepositoryInput {
    email: string;
    phone?: string | null;
    password_hash: string;
    first_name: string;
    last_name: string;
    birth_date: string;
    gender: string;
    facial_structure_type?: FacialStructureType | null;
    completed_services_count?: number;
}

export interface UpdateClientRepositoryInput {
    id: string;
    email?: string;
    phone?: string | null;
    password?: string;
    firstName?: string;
    lastName?: string;
    birthDate?: string;
    gender?: string;
    facialStructureType?: FacialStructureType | null;
    completedServicesCount?: number;
}

export interface ClientWithUser {
    id: string;
    role: UserRole;
    email: string;
    phone: string | null;
    password_hash: string;
    first_name: string;
    last_name: string;
    birth_date: string;
    gender: string;
    facial_structure_type: FacialStructureType | null;
    completed_services_count: number;
    created_at: Date;
    updated_at: Date;
    client_telegram_id: string | null;
}

const CLIENT_COLUMNS = `
    u.id, u.role, u.email, u.phone, u.password_hash, u.first_name, u.last_name,
    u.birth_date, u.gender, u.created_at, u.updated_at,
    c.facial_structure_type, c.completed_services_count, c.client_telegram_id
`;

/**
 * Busca el perfil de un cliente por su user_id.
 */
export const getClientByUserId = async (userId: string): Promise<Client | null> => {
    const pool = db.getPool();

    const result = await pool.query(
        `SELECT user_id, facial_structure_type, completed_services_count FROM clients WHERE user_id = $1`,
        [userId]
    );

    return result.rows.length ? result.rows[0] : null;
};

export const updateClientFacialStructure = async (userId: string, facialStructure: string): Promise<void> => {
    const pool = db.getPool();

    await pool.query(`UPDATE clients SET facial_structure_type = $1 WHERE user_id = $2`, [facialStructure, userId]);
};

/**
 * Descarta la estructura facial guardada para que se vuelva a detectar a partir de la foto vigente.
 */
export const clearClientFacialStructure = async (userId: string): Promise<void> => {
    const pool = db.getPool();

    await pool.query(`UPDATE clients SET facial_structure_type = NULL WHERE user_id = $1`, [userId]);
};

export const getAppointmentClientsById = async (clientIds: string[]): Promise<AppointmentClient[]> => {
    if (clientIds.length === 0) return [];

    const result = await db.getPool().query(
        `SELECT u.id, u.first_name AS "firstName", u.last_name AS "lastName", u.email, u.phone,
            c.completed_services_count AS "completedServicesCount"
        FROM users u
        JOIN clients c ON c.user_id = u.id
        WHERE u.role = 'client' AND u.id = ANY($1::uuid[])`,
        [clientIds]
    );

    return result.rows;
};

/**
 * Obtiene un cliente por su ID combinando los datos de users y clients.
 */
export const getClientById = async (id: string): Promise<ClientWithUser | null> => {
    const pool = db.getPool();
    const query = `
        SELECT ${CLIENT_COLUMNS}
        FROM users u
        JOIN clients c ON c.user_id = u.id
        WHERE u.id = $1 AND u.role = 'client'
    `;
    const result = await pool.query(query, [id]);
    return result.rows.length ? result.rows[0] : null;
};

/**
 * Busca clientes por coincidencia parcial en nombre, apellido, nombre completo o correo.
 */
export const searchClients = async (term: string): Promise<ClientWithUser[]> => {
    const pool = db.getPool();
    const escaped = term.replace(/[\\%_]/g, '\\$&');
    const query = `
        SELECT ${CLIENT_COLUMNS}
        FROM users u
        JOIN clients c ON c.user_id = u.id
        WHERE u.role = 'client'
          AND (
              u.first_name ILIKE $1
              OR u.last_name ILIKE $1
              OR u.email ILIKE $1
              OR CONCAT(u.first_name, ' ', u.last_name) ILIKE $1
          )
        ORDER BY u.first_name, u.last_name
        LIMIT 20
    `;
    const result = await pool.query(query, [`%${escaped}%`]);
    return result.rows;
};

/**
 * Obtiene la lista completa de todos los clientes registrados.
 */
export const getAllClients = async (): Promise<ClientWithUser[]> => {
    const pool = db.getPool();
    const query = `
        SELECT ${CLIENT_COLUMNS}
        FROM users u
        JOIN clients c ON c.user_id = u.id
        WHERE u.role = 'client'
        ORDER BY u.created_at DESC
    `;
    const result = await pool.query(query);
    return result.rows;
};

/**
 * Ejecuta una transacción SQL para crear un cliente manipulando users y clients.
 * Valida unicidad de email y teléfono antes de insertar.
 */
export const createClient = async (data: CreateClientRepositoryInput): Promise<ClientWithUser> => {
    const pool = db.getPool();
    const client = await pool.connect();

    try {
        await client.query('BEGIN');

        // 1. Valida unicidad de correo
        const emailCheck = await client.query('SELECT id FROM users WHERE email = $1', [data.email]);
        if (emailCheck.rows.length > 0) {
            throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Email is already registered');
        }

        // 2. Valida unicidad de teléfono si se proporciona
        if (data.phone) {
            const phoneCheck = await client.query('SELECT id FROM users WHERE phone = $1', [data.phone]);
            if (phoneCheck.rows.length > 0) {
                throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Phone is already registered');
            }
        }

        // 3. Inserta en la tabla 'users' con role = 'client'
        const insertUserQuery = `
            INSERT INTO users (role, email, phone, password_hash, first_name, last_name, birth_date, gender)
            VALUES ('client', $1, $2, $3, $4, $5, $6, $7)
            RETURNING id, role, email, phone, password_hash, first_name, last_name, birth_date, gender, created_at, updated_at
        `;
        const userResult = await client.query(insertUserQuery, [
            data.email,
            data.phone ?? null,
            data.password_hash,
            data.first_name,
            data.last_name,
            data.birth_date,
            data.gender,
        ]);
        const newUser = userResult.rows[0];

        // 4. Inserta en la tabla 'clients' asociada
        const insertClientQuery = `
            INSERT INTO clients (user_id, facial_structure_type, completed_services_count)
            VALUES ($1, $2, $3)
            RETURNING user_id, facial_structure_type, completed_services_count
        `;
        const clientResult = await client.query(insertClientQuery, [
            newUser.id,
            data.facial_structure_type ?? null,
            data.completed_services_count ?? 0,
        ]);
        const newClient = clientResult.rows[0];

        await client.query('COMMIT');

        return {
            ...newUser,
            facial_structure_type: newClient.facial_structure_type,
            completed_services_count: newClient.completed_services_count,
        };
    } catch (error: unknown) {
        await client.query('ROLLBACK');
        const dbError = error as { code?: string; constraint?: string };
        if (dbError.code === '23505') {
            if (dbError.constraint?.includes('email')) {
                throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Email is already registered');
            }
            if (dbError.constraint?.includes('phone')) {
                throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Phone is already registered');
            }
            throw new ApiError(ApiErrorCode.CONFLICT, 'Unique constraint violation');
        }
        throw error;
    } finally {
        client.release();
    }
};

/**
 * Ejecuta una transacción SQL para actualizar un cliente en users y/o clients.
 * Bloquea el registro con FOR UPDATE y valida unicidad de email/teléfono si cambiaron.
 */
export const updateClientById = async (fields: UpdateClientRepositoryInput): Promise<ClientWithUser> => {
    const pool = db.getPool();
    const client = await pool.connect();

    try {
        await client.query('BEGIN');

        // 1. Bloquea y verifica que el registro exista y sea cliente
        const currentResult = await client.query('SELECT id, role FROM users WHERE id = $1 FOR UPDATE', [fields.id]);
        if (currentResult.rows.length === 0 || currentResult.rows[0].role !== 'client') {
            throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client not found');
        }

        // 2. Verifica unicidad de correo y teléfono si se están modificando
        if (fields.email !== undefined) {
            const emailCheck = await client.query('SELECT id FROM users WHERE email = $1 AND id <> $2', [
                fields.email,
                fields.id,
            ]);
            if (emailCheck.rows.length > 0) {
                throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Email is already registered');
            }
        }

        if (fields.phone !== undefined && fields.phone !== null) {
            const phoneCheck = await client.query('SELECT id FROM users WHERE phone = $1 AND id <> $2', [
                fields.phone,
                fields.id,
            ]);
            if (phoneCheck.rows.length > 0) {
                throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Phone is already registered');
            }
        }

        // 3. Actualización dinámica en tabla 'users'
        const userSetClauses: string[] = [];
        const userValues: unknown[] = [];
        const userColumns: [keyof UpdateClientRepositoryInput, string][] = [
            ['email', 'email'],
            ['phone', 'phone'],
            ['password', 'password_hash'],
            ['firstName', 'first_name'],
            ['lastName', 'last_name'],
            ['birthDate', 'birth_date'],
            ['gender', 'gender'],
        ];

        for (const [field, column] of userColumns) {
            const value = fields[field];
            if (value !== undefined) {
                userValues.push(value);
                userSetClauses.push(`${column} = $${userValues.length}`);
            }
        }

        if (userSetClauses.length > 0) {
            userValues.push(fields.id);
            await client.query(
                `UPDATE users SET ${userSetClauses.join(', ')} WHERE id = $${userValues.length}`,
                userValues
            );
        }

        // 4. Actualización dinámica en tabla 'clients'
        const clientSetClauses: string[] = [];
        const clientValues: unknown[] = [];
        if (fields.facialStructureType !== undefined) {
            clientValues.push(fields.facialStructureType);
            clientSetClauses.push(`facial_structure_type = $${clientValues.length}`);
        }
        if (fields.completedServicesCount !== undefined) {
            clientValues.push(fields.completedServicesCount);
            clientSetClauses.push(`completed_services_count = $${clientValues.length}`);
        }

        if (clientSetClauses.length > 0) {
            clientValues.push(fields.id);
            await client.query(
                `UPDATE clients SET ${clientSetClauses.join(', ')} WHERE user_id = $${clientValues.length}`,
                clientValues
            );
        }

        // 5. Consulta los datos actualizados
        const updatedResult = await client.query(
            `SELECT ${CLIENT_COLUMNS}
             FROM users u
             JOIN clients c ON c.user_id = u.id
             WHERE u.id = $1`,
            [fields.id]
        );

        await client.query('COMMIT');
        return updatedResult.rows[0];
    } catch (error: unknown) {
        await client.query('ROLLBACK');
        const dbError = error as { code?: string; constraint?: string };
        if (dbError.code === '23505') {
            if (dbError.constraint?.includes('email')) {
                throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Email is already registered');
            }
            if (dbError.constraint?.includes('phone')) {
                throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Phone is already registered');
            }
            throw new ApiError(ApiErrorCode.CONFLICT, 'Unique constraint violation');
        }
        throw error;
    } finally {
        client.release();
    }
};

/**
 * Ejecuta una transacción SQL para eliminar físicamente un cliente de clients y users.
 */
export const deleteClientById = async (id: string): Promise<void> => {
    const pool = db.getPool();
    const client = await pool.connect();

    try {
        await client.query('BEGIN');

        // 1. Verifica si existe y es cliente
        const userCheck = await client.query('SELECT id, role FROM users WHERE id = $1', [id]);
        if (userCheck.rows.length === 0 || userCheck.rows[0].role !== 'client') {
            throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client not found');
        }

        // 2. Borra primero de la tabla 'clients'
        await client.query('DELETE FROM clients WHERE user_id = $1', [id]);

        // 3. Borra de la tabla 'users'
        const result = await client.query('DELETE FROM users WHERE id = $1', [id]);
        if (result.rowCount === 0) {
            throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client not found');
        }

        await client.query('COMMIT');
    } catch (error) {
        await client.query('ROLLBACK');
        throw error;
    } finally {
        client.release();
    }
};

export interface LoyaltyState {
    completedServicesCount: number;
    hasOpenRewardAppointment: boolean;
}

const queryLoyaltyState = async (
    queryable: Pick<Pool | PoolClient, 'query'>,
    userId: string,
    forUpdate: boolean
): Promise<LoyaltyState | null> => {
    const lockClause = forUpdate ? ' FOR UPDATE' : '';
    const clientResult = await queryable.query<{ completed_services_count: number }>(
        `SELECT completed_services_count FROM clients WHERE user_id = $1${lockClause}`,
        [userId]
    );
    if (clientResult.rows.length === 0) {
        return null;
    }

    const openRewardResult = await queryable.query(
        `SELECT 1 FROM appointments
         WHERE client_id = $1
           AND is_reward_redemption = true
           AND status IN ('scheduled', 'rescheduled', 'checked_in')
         LIMIT 1`,
        [userId]
    );

    return {
        completedServicesCount: clientResult.rows[0].completed_services_count,
        hasOpenRewardAppointment: openRewardResult.rows.length > 0,
    };
};

/**
 * Obtiene el estado de lealtad de un cliente usando el pool (sin candado, para consultas de lectura).
 */
export const getLoyaltyState = async (userId: string): Promise<LoyaltyState | null> =>
    queryLoyaltyState(db.getPool(), userId, false);

/**
 * Obtiene y bloquea (`FOR UPDATE`) el estado de lealtad del cliente usando la conexión de una transacción abierta.
 * No abre ni cierra transacciones.
 */
export const getLoyaltyStateForUpdate = async (
    client: PoolClient,
    userId: string
): Promise<LoyaltyState | null> => queryLoyaltyState(client, userId, true);

/* Para poner el chat_id de Telegram */
export const updateClientTelegramId = async (
    clientId: string,
    telegramChatId: string
): Promise<boolean> => {
    const pool = db.getPool();

    const query = `
        UPDATE clients
        SET client_telegram_id = $1
        WHERE user_id = $2
        RETURNING user_id;
    `;
    const result = await pool.query(query, [telegramChatId, clientId]);
    return (result.rowCount ?? 0) > 0;
};

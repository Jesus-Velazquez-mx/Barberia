<file path="backend/src/services/shiftService.ts">
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import {
    getAllShifts,
    getShiftById,
    getShiftByName,
    getShiftByTimes,
    createShift as repoCreateShift,
    updateShift as repoUpdateShift,
    deleteShiftIfAllowed,
    type CreateShiftInput,
    type UpdateShiftInput,
} from '../repositories/shiftRepository.js';
import { isUserActive } from '../repositories/userRepository.js';
import { decodeToken } from './jwtTokenService.js';
import { canManageShifts, canViewShifts, type UserIdentity } from './userPermissions.js';
import { timeToMinutes } from '../utils/businessTime.js';
import type { Shift } from '../types/entities/shift.interface.js';

/** Duraciones permitidas para un turno, en horas. */
export const ALLOWED_SHIFT_HOURS = [4, 6, 8];

/**
 * Decodifica el token y exige que el usuario tenga el permiso indicado y una cuenta activa.
 */
const authorize = async (
    token: string,
    isAllowed: (performer: UserIdentity) => boolean,
    forbiddenMessage: string
): Promise<void> => {
    const performer = decodeToken(token);

    if (!isAllowed(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, forbiddenMessage);
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }
};

/**
 * Valida que el fin sea posterior al inicio y que la duración sea de 4, 6 u 8 horas.
 */
const assertValidTimeRange = (startTime: string, endTime: string): void => {
    const minutes = timeToMinutes(endTime) - timeToMinutes(startTime);

    if (minutes <= 0) {
        throw new ApiError(ApiErrorCode.INVALID_INPUT, 'Shift end time must be after its start time');
    }

    if (!ALLOWED_SHIFT_HOURS.some((hours) => hours * 60 === minutes)) {
        throw new ApiError(ApiErrorCode.INVALID_INPUT, `Shift length must be ${ALLOWED_SHIFT_HOURS.join(', ')} hours`);
    }
};

const assertNameAvailable = async (name: string, ownId?: string): Promise<void> => {
    const existing = await getShiftByName(name);
    if (existing && existing.id !== ownId) {
        throw new ApiError(ApiErrorCode.CONFLICT, 'Shift name is already in use');
    }
};

const assertTimesAvailable = async (startTime: string, endTime: string, ownId?: string): Promise<void> => {
    const existing = await getShiftByTimes(startTime, endTime);
    if (existing && existing.id !== ownId) {
        throw new ApiError(ApiErrorCode.CONFLICT, 'Another shift already has this exact start and end time');
    }
};

/**
 * Código 23505 de PostgreSQL: violación de UNIQUE (carrera entre la verificación previa y la escritura).
 */
const translateUniqueViolation = (error: unknown): never => {
    if ((error as { code?: string }).code === '23505') {
        throw new ApiError(ApiErrorCode.CONFLICT, 'Shift name or time range is already in use');
    }
    throw error;
};

/**
 * Recupera todos los turnos.
 * Requiere rol de manager o recepcionista y cuenta activa.
 */
export const listShifts = async (token: string): Promise<Shift[]> => {
    await authorize(token, canViewShifts, 'Not authorized to view shifts');
    return await getAllShifts();
};

/**
 * Obtiene un turno por su ID.
 * Requiere rol de manager o recepcionista y cuenta activa.
 * Lanza un error 404 si el turno no existe.
 */
export const getShift = async (id: string, token: string): Promise<Shift> => {
    await authorize(token, canViewShifts, 'Not authorized to view shifts');

    const shift = await getShiftById(id);
    if (!shift) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shift not found');
    }
    return shift;
};

/**
 * Registra un nuevo turno.
 * Requiere rol de manager y cuenta activa.
 * Valida la duración (4, 6 u 8 horas), que el nombre no esté en uso y que no exista otro turno con el mismo horario.
 */
export const registerShift = async (data: CreateShiftInput, token: string): Promise<Shift> => {
    await authorize(token, canManageShifts, 'Not authorized to create shifts');

    assertValidTimeRange(data.start_time, data.end_time);
    await assertNameAvailable(data.name);
    await assertTimesAvailable(data.start_time, data.end_time);

    try {
        return await repoCreateShift(data);
    } catch (error: unknown) {
        return translateUniqueViolation(error);
    }
};

/**
 * Edita un turno existente.
 * Requiere rol de manager y cuenta activa.
 * Las validaciones de duración y horario duplicado se aplican sobre los valores resultantes
 * (los actuales combinados con los enviados), ignorando al propio turno.
 */
export const editShift = async (id: string, data: UpdateShiftInput, token: string): Promise<Shift> => {
    await authorize(token, canManageShifts, 'Not authorized to update shifts');

    const shift = await getShiftById(id);
    if (!shift) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shift not found');
    }

    const startTime = data.start_time ?? shift.start_time;
    const endTime = data.end_time ?? shift.end_time;

    assertValidTimeRange(startTime, endTime);

    if (data.name !== undefined) {
        await assertNameAvailable(data.name, id);
    }
    if (data.start_time !== undefined || data.end_time !== undefined) {
        await assertTimesAvailable(startTime, endTime, id);
    }

    try {
        return await repoUpdateShift(id, data);
    } catch (error: unknown) {
        return translateUniqueViolation(error);
    }
};

/**
 * Elimina físicamente un turno.
 * Requiere rol de manager y cuenta activa.
 * No se puede eliminar si es el único turno existente ni si tiene personal (barberos o recepcionistas) asignado.
 */
export const removeShift = async (id: string, token: string): Promise<void> => {
    await authorize(token, canManageShifts, 'Not authorized to delete shifts');

    const result = await deleteShiftIfAllowed(id);

    switch (result) {
        case 'not_found':
            throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shift not found');
        case 'last_shift':
            throw new ApiError(
                ApiErrorCode.CONFLICT,
                'Cannot delete the only existing shift; create another shift first'
            );
        case 'has_staff':
            throw new ApiError(ApiErrorCode.CONFLICT, 'Cannot delete shift because it has staff assigned');
        case 'deleted':
            return;
    }
};
</file>

<file path="backend/src/services/shopService.ts">
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import {
    getActiveShops,
    getAllShops,
    getShopById,
    getShopByName,
    createShop as repoCreateShop,
    updateShop as repoUpdateShop,
    softDeleteShop as repoSoftDeleteShop,
    getShopsByManagerId,
} from '../repositories/shopRepository.js';
import { getManagerByUserId } from '../repositories/managerRepository.js';
import { isUserActive } from '../repositories/userRepository.js';
import { decodeToken } from './jwtTokenService.js';
import { canManageShops } from './userPermissions.js';
import type { ShopResponse } from '../types/dto/shopResponse.interface.js';
import type { CreateShopRequest, UpdateShopRequest } from '../types/dto/shopRequest.interface.js';
import { toShopResponse } from '../utils/shopMapper.js';
import { getReceptionistWithUserById } from '../repositories/receptionistRepository.js';

export const listActiveShops = async (): Promise<ShopResponse[]> => {
    const shops = await getActiveShops();
    return shops.map(toShopResponse);
};

export const listShops = async (includeInactive = false, token?: string): Promise<ShopResponse[]> => {
    let performer;

    if (token) {
        performer = decodeToken(token);
    }

    if (performer && performer.role !== 'client') {
        if (!(await isUserActive(performer.id))) {
            throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
        }

        if (performer.role === 'receptionist') {
            const receptionistShopId = (await getReceptionistWithUserById(performer.id))?.shop_id
            if (receptionistShopId) {
                const shop = await getShopById(receptionistShopId);
                if (shop) {
                    if (includeInactive) {
                        return [toShopResponse(shop)];
                    } else {
                        return (shop && shop.is_active) ? [toShopResponse(shop)] : [];
                    }
                } else {
                    return [];
                }
            }

            return [];
        } else if (performer.role === 'manager') {
            return (await getShopsByManagerId(performer.id, includeInactive)).map(shop => toShopResponse(shop));
        }
    }

    return await listAllShops();
};

const listAllShops = async (includeInactive = false): Promise<ShopResponse[]> => {
    const shops = includeInactive ? await getAllShops() : await getActiveShops();
    return shops.map(toShopResponse);
}

export const getActiveShopById = async (id: string): Promise<ShopResponse> => {
    const shop = await getShopById(id);

    // Si no existe o está inactiva, devolvemos 404 ya que no debe ser agendable
    if (!shop || !shop.is_active) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shop not found or is inactive');
    }

    return toShopResponse(shop);
};

/**
 * Registra una nueva sucursal.
 * Requiere rol de manager y cuenta activa.
 */
export const registerShop = async (data: CreateShopRequest, token: string): Promise<ShopResponse> => {
    const performer = decodeToken(token);

    if (!canManageShops(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to create shops');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const targetManagerId = data.managerId ?? performer.id;

    // Verificar que el manager asignado exista y esté activo
    const manager = await getManagerByUserId(targetManagerId);
    if (!manager || manager.deleted_at !== null) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Manager not found or is deactivated');
    }

    // Verificar unicidad de nombre de sucursal
    const existing = await getShopByName(data.name);
    if (existing) {
        throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Shop name is already in use');
    }

    const createdShop = await repoCreateShop({
        ...data,
        managerId: targetManagerId,
    });

    return toShopResponse(createdShop);
};

/**
 * Edita la información de una sucursal existente.
 * Requiere rol de manager y cuenta activa.
 */
export const editShop = async (id: string, data: UpdateShopRequest, token: string): Promise<ShopResponse> => {
    const performer = decodeToken(token);

    if (!canManageShops(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to update shops');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const shop = await getShopById(id);
    if (!shop) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shop not found');
    }

    // Si cambia el nombre, validar que no colisione con otra sucursal
    if (data.name && data.name.toLowerCase() !== shop.name.toLowerCase()) {
        const existing = await getShopByName(data.name);
        if (existing && existing.id !== id) {
            throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Shop name is already in use');
        }
    }

    // Si cambia el manager, validar que exista y esté activo
    if (data.managerId) {
        const manager = await getManagerByUserId(data.managerId);
        if (!manager || manager.deleted_at !== null) {
            throw new ApiError(ApiErrorCode.NOT_FOUND, 'Manager not found or is deactivated');
        }
    }

    const updatedShop = await repoUpdateShop(id, data);
    return toShopResponse(updatedShop);
};

/**
 * Elimina lógicamente una sucursal.
 * Realiza un borrado lógico marcando is_active = false.
 */
export const removeShop = async (id: string, token: string): Promise<void> => {
    const performer = decodeToken(token);

    if (!canManageShops(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to delete shops');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const shop = await getShopById(id);
    if (!shop) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shop not found');
    }

    await repoSoftDeleteShop(id);
};
</file>

<file path="backend/src/services/suppliesCategoryService.ts">
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import {
    getAllCategories,
    getCategoryById,
    getCategoryByName,
    createCategory as repoCreateCategory,
    updateCategory as repoUpdateCategory,
    deleteCategory as repoDeleteCategory,
} from '../repositories/suppliesCategoryRepository.js';
import { isUserActive } from '../repositories/userRepository.js';
import { decodeToken } from './jwtTokenService.js';
import { canManageSuppliesCategories } from '../services/userPermissions.js';

/**
 * Recupera la lista completa de categorías de insumos.
 * Requiere rol de manager o receptionist y cuenta activa.
 */
export const listCategories = async (token: string) => {
    const performer = decodeToken(token);

    if (!canManageSuppliesCategories(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to view categories');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    return await getAllCategories();
};

/**
 * Obtiene los detalles de una categoría por su ID.
 * Requiere rol de manager o receptionist y cuenta activa.
 * Lanza un error 404 si la categoría no existe.
 */
export const getCategory = async (id: string, token: string) => {
    const performer = decodeToken(token);

    if (!canManageSuppliesCategories(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to view categories');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const category = await getCategoryById(id);
    if (!category) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Category not found');
    }
    return category;
};

/**
 * Registra una nueva categoría de insumos.
 * Requiere rol de manager o receptionist y cuenta activa.
 * Valida que el nombre de la categoría no esté en uso.
 */
export const registerCategory = async (data: { name: string; description?: string | null }, token: string) => {
    const performer = decodeToken(token);

    if (!canManageSuppliesCategories(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to create categories');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    // Verificar unicidad de nombre de categoría
    const existing = await getCategoryByName(data.name);
    if (existing) {
        throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Category name is already in use');
    }

    return await repoCreateCategory(data);
};

/**
 * Edita la información de una categoría existente.
 * Requiere rol de manager o receptionist y cuenta activa.
 * Valida que el nuevo nombre no colisione con otra categoría.
 */
export const editCategory = async (id: string, data: { name?: string; description?: string | null }, token: string) => {
    const performer = decodeToken(token);

    if (!canManageSuppliesCategories(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to update categories');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const category = await getCategoryById(id);
    if (!category) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Category not found');
    }

    // Si cambia el nombre, validar que no colisione con otra categoría diferente
    if (data.name && data.name.toLowerCase() !== category.name.toLowerCase()) {
        const existing = await getCategoryByName(data.name);
        if (existing && existing.id !== id) {
            throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Category name is already in use');
        }
    }

    return await repoUpdateCategory(id, data);
};

/**
 * Elimina físicamente una categoría de insumos.
 * Requiere rol de manager o receptionist y cuenta activa.
 * Traduce el error de base de datos (ON DELETE RESTRICT) si la categoría está en uso por insumos.
 */
export const removeCategory = async (id: string, token: string): Promise<void> => {
    const performer = decodeToken(token);

    if (!canManageSuppliesCategories(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to delete categories');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const category = await getCategoryById(id);
    if (!category) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Category not found');
    }

    try {
        await repoDeleteCategory(id);
    } catch (error: unknown) {
        // Códigos PostgreSQL para violación de integridad referencial:
        // 23503 (foreign_key_violation) y 23001 (restrict_violation)
        const dbError = error as { code?: string };
        if (dbError.code === '23503' || dbError.code === '23001') {
            throw new ApiError(ApiErrorCode.BAD_REQUEST, 'Cannot delete category because it has supplies assigned');
        }
        throw error;
    }
};
</file>

<file path="backend/src/services/supplyService.ts">
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import {
    getSuppliesByShopId,
    getSupplyById,
    getSupplyByNameAndShop,
    getSupplyBySkuAndShop,
    createSupply as repoCreateSupply,
    updateSupply as repoUpdateSupply,
    deleteSupply as repoDeleteSupply,
    type CreateSupplyInput,
    type UpdateSupplyInput,
} from '../repositories/supplyRepository.js';
import { getShopById, getShopIdsByManagerId } from '../repositories/shopRepository.js';
import { getReceptionistByUserId } from '../repositories/receptionistRepository.js';
import { getCategoryById } from '../repositories/suppliesCategoryRepository.js';
import { isUserActive } from '../repositories/userRepository.js';
import { decodeToken } from './jwtTokenService.js';
import { canManageSupplies, canViewShopSupplies, type UserIdentity } from './userPermissions.js';

/**
 * Sucursales a las que tiene acceso el usuario: la del recepcionista o las que administra el gerente.
 */
const getAssignedShopIds = async (performer: UserIdentity): Promise<string[]> => {
    if (performer.role === 'receptionist') {
        const receptionist = await getReceptionistByUserId(performer.id);
        if (!receptionist) {
            throw new ApiError(ApiErrorCode.FORBIDDEN, 'Receptionist is not assigned to a shop');
        }
        return [receptionist.shop_id];
    }
    return await getShopIdsByManagerId(performer.id);
};

/**
 * Lanza 403 si la sucursal no está entre las asignadas al usuario.
 */
const assertShopAccess = (shopId: string, assignedShopIds: string[], action: string): void => {
    if (!canViewShopSupplies(shopId, assignedShopIds)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, `Not authorized to ${action} supplies of this shop`);
    }
};

/**
 * Recupera la lista de insumos.
 * - Sin shopIds: usa las sucursales asignadas al recepcionista (su sucursal) o al gerente (las que administra).
 * - Con shopIds: cada una debe estar asignada al usuario; si alguna no lo está, responde 403.
 */
export const listSupplies = async (shopIds?: string[], token?: string) => {
    const performer = decodeToken(token!);

    if (!canManageSupplies(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to view supplies');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const assignedShopIds = await getAssignedShopIds(performer);

    let targetShopIds = assignedShopIds;
    if (shopIds && shopIds.length > 0) {
        const uniqueShopIds = [...new Set(shopIds)];
        if (!uniqueShopIds.every((id) => canViewShopSupplies(id, assignedShopIds))) {
            throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to view supplies of one or more shops');
        }
        targetShopIds = uniqueShopIds;
    }

    // El repositorio no filtra con un arreglo vacío (devolvería todos los insumos), así que se corta aquí.
    if (targetShopIds.length === 0) return [];

    return await getSuppliesByShopId(targetShopIds);
};

/**
 * Obtiene los detalles de un insumo específico.
 */
export const getSupply = async (id: string, token?: string) => {
    const performer = decodeToken(token!);

    if (!canManageSupplies(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to view supplies');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const supply = await getSupplyById(id);
    if (!supply) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Supply not found');
    }

    assertShopAccess(supply.shop_id, await getAssignedShopIds(performer), 'view');
    return supply;
};

/**
 * Registra un nuevo insumo.
 */
export const registerSupply = async (data: CreateSupplyInput, token: string) => {
    const performer = decodeToken(token);

    if (!canManageSupplies(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to manage supplies');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    // Validar que la sucursal existe
    const shop = await getShopById(data.shopId);
    if (!shop) throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shop not found');

    // Solo se pueden registrar insumos en las sucursales asignadas al usuario
    assertShopAccess(data.shopId, await getAssignedShopIds(performer), 'manage');

    // Validar que la categoría existe
    const category = await getCategoryById(data.categoryId);
    if (!category) throw new ApiError(ApiErrorCode.NOT_FOUND, 'Category not found');

    // Validar que el nombre no esté duplicado en esta sucursal
    const nameExists = await getSupplyByNameAndShop(data.name, data.shopId);
    if (nameExists) throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Supply name is already in use in this shop');

    // Validar que el SKU no esté duplicado en esta sucursal (si se envió uno)
    if (data.sku) {
        const skuExists = await getSupplyBySkuAndShop(data.sku, data.shopId);
        if (skuExists) throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'SKU is already in use in this shop');
    }

    return await repoCreateSupply(data);
};

/**
 * Edita un insumo existente.
 */
export const editSupply = async (id: string, data: UpdateSupplyInput, token: string) => {
    const performer = decodeToken(token);

    if (!canManageSupplies(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to manage supplies');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const supply = await getSupplyById(id);
    if (!supply) throw new ApiError(ApiErrorCode.NOT_FOUND, 'Supply not found');

    // El insumo debe pertenecer a una sucursal asignada al usuario
    const assignedShopIds = await getAssignedShopIds(performer);
    assertShopAccess(supply.shop_id, assignedShopIds, 'manage');

    const targetShopId = data.shopId || supply.shop_id;

    // Si cambian la sucursal, validar que la nueva exista y que también esté asignada al usuario
    if (data.shopId && data.shopId !== supply.shop_id) {
        const shop = await getShopById(data.shopId);
        if (!shop) throw new ApiError(ApiErrorCode.NOT_FOUND, 'Shop not found');
        assertShopAccess(data.shopId, assignedShopIds, 'manage');
    }

    // Si cambian la categoría, validar que la nueva exista
    if (data.categoryId && data.categoryId !== supply.category_id) {
        const category = await getCategoryById(data.categoryId);
        if (!category) throw new ApiError(ApiErrorCode.NOT_FOUND, 'Category not found');
    }

    // Validar duplicado de nombre (solo si cambia el nombre o la sucursal)
    if ((data.name && data.name.toLowerCase() !== supply.name.toLowerCase()) || data.shopId) {
        const nameToCheck = data.name || supply.name;
        const nameExists = await getSupplyByNameAndShop(nameToCheck, targetShopId);
        if (nameExists && nameExists.id !== id) {
            throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'Supply name is already in use in this shop');
        }
    }

    // Validar duplicado de SKU (solo si cambia el SKU o la sucursal)
    if ((data.sku && data.sku !== supply.sku) || (data.shopId && supply.sku)) {
        const skuToCheck = data.sku !== undefined ? data.sku : supply.sku;
        if (skuToCheck) {
            const skuExists = await getSupplyBySkuAndShop(skuToCheck, targetShopId);
            if (skuExists && skuExists.id !== id) {
                throw new ApiError(ApiErrorCode.USER_ALREADY_EXISTS, 'SKU is already in use in this shop');
            }
        }
    }

    return await repoUpdateSupply(id, data);
};

/**
 * Elimina físicamente un insumo.
 */
export const removeSupply = async (id: string, token: string): Promise<void> => {
    const performer = decodeToken(token);

    if (!canManageSupplies(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to delete supplies');
    }

    if (!(await isUserActive(performer.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const supply = await getSupplyById(id);
    if (!supply) throw new ApiError(ApiErrorCode.NOT_FOUND, 'Supply not found');

    assertShopAccess(supply.shop_id, await getAssignedShopIds(performer), 'manage');

    await repoDeleteSupply(id);
};
</file>


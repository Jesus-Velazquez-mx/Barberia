import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import { getLoyaltyState } from '../repositories/clientRepository.js';
import type { LoyaltyStatusResponse } from '../types/dto/clientResponse.interface.js';
import { evaluateReward, LOYALTY_REWARD_THRESHOLD } from '../utils/loyalty.js';
import { isUserSessionValid } from '../utils/userSession.js';
import { canViewClientLoyalty } from './userPermissions.js';

export { evaluateReward, LOYALTY_REWARD_THRESHOLD };

/**
 * Construye el estado de lealtad completo de un cliente a partir de su lectura sin candado.
 */
export const getLoyaltyStatus = async (clientId: string, token?: string): Promise<LoyaltyStatusResponse> => {
    if (token !== undefined) {
        const actor = await isUserSessionValid(token);
        if (!canViewClientLoyalty({ id: actor.id, role: actor.role }, clientId)) {
            throw new ApiError(ApiErrorCode.FORBIDDEN, 'You do not have permission to view this client loyalty status');
        }
    }

    const loyaltyState = await getLoyaltyState(clientId);
    if (!loyaltyState) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client not found');
    }

    const { rewardAvailable, rewardAppliesOnNextBooking } = evaluateReward(
        loyaltyState.completedServicesCount,
        loyaltyState.hasOpenRewardAppointment
    );

    return {
        completedServicesCount: loyaltyState.completedServicesCount,
        threshold: LOYALTY_REWARD_THRESHOLD,
        appointmentsUntilReward: Math.max(0, LOYALTY_REWARD_THRESHOLD - loyaltyState.completedServicesCount),
        rewardAvailable,
        hasOpenRewardAppointment: loyaltyState.hasOpenRewardAppointment,
        rewardAppliesOnNextBooking,
    };
};
</file>

<file path="backend/src/services/recommendationHistoryService.ts">
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import { getClientByUserId } from '../repositories/clientRepository.js';
import {
    getRecommendationHistoryByClientId,
    type RecommendationHistoryWithHaircuts,
} from '../repositories/recommendationHistoryRepository.js';
import type {
    RecommendationHistoryEntryDTO,
    RecommendationHistoryStatus,
} from '../types/dto/recommendation.interface.js';
import { isUserSessionValid } from '../utils/userSession.js';
import { canViewRecommendationHistory } from './userPermissions.js';

/**
 * Devuelve el historial de recomendaciones de un cliente, de la más reciente a la más antigua.
 * Un cliente solo puede consultar el suyo; la recepción y los gerentes pueden consultar el de cualquiera.
 */
export const getRecommendationHistory = async (
    clientId: string,
    token: string
): Promise<RecommendationHistoryEntryDTO[]> => {
    const performer = await isUserSessionValid(token);

    if (!canViewRecommendationHistory(performer, clientId)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, "You are not allowed to view this client's recommendation history");
    }

    if (!(await getClientByUserId(clientId))) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client could not be found');
    }

    const history = await getRecommendationHistoryByClientId(clientId);
    return history.map(toHistoryEntryDTO);
};

/** Las filas fallidas ya vienen excluidas, así que la ausencia de sugerencia significa que ningún corte aplicó. */
const toStatus = (row: RecommendationHistoryWithHaircuts): RecommendationHistoryStatus =>
    row.suggestion_text !== null ? 'recommended' : 'no_suitable_haircut';

const toHistoryEntryDTO = (row: RecommendationHistoryWithHaircuts): RecommendationHistoryEntryDTO => ({
    id: row.id,
    status: toStatus(row),
    suggestionText: row.suggestion_text,
    // pg devuelve las columnas numeric como string.
    confidence: row.confidence === null ? null : Number(row.confidence),
    reasoning: row.reasoning,
    recommendedHaircuts: row.recommended_haircuts,
    requestedAt: row.requested_at,
    completedAt: row.completed_at,
});
</file>

<file path="backend/src/services/reportService.ts">
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import { getBarberPerformance } from '../repositories/reportRepository.js';
import { getShopById, getShopIdsByManagerId } from '../repositories/shopRepository.js';
import { canGenerateReports, canGenerateShopReports } from './userPermissions.js';
import { getBusinessTimezone } from '../utils/businessTime.js';
import { dateOnlySchema } from '../utils/dateOnly.js';
import { toBarberPerformanceResponse, toPerformanceTotals } from '../utils/reportMapper.js';
import { isUserSessionValid } from '../utils/userSession.js';
import type { BarberPerformance } from '../types/entities/barberPerformance.interface.js';
import type { BarberPerformanceReportRequest } from '../types/dto/reportRequest.interface.js';
import type { BarberPerformanceReportResponse } from '../types/dto/reportResponse.interface.js';

// Textos definidos por el caso de uso CU-49; el frontend los muestra tal cual.
export const REPORT_SHOP_FORBIDDEN_MESSAGE = 'No cuenta con permisos para generar reportes de esta sucursal.';
export const REPORT_INVALID_RANGE_MESSAGE = 'El rango de fechas proporcionado no es válido.';
export const REPORT_NO_DATA_MESSAGE =
    'No hay datos suficientes para generar el reporte en el rango de fechas indicado.';
// Complemento al caso de uso: distingue un nombre mal escrito de un periodo sin actividad.
export const REPORT_BARBER_NOT_FOUND_MESSAGE =
    'No se encontraron barberos con los datos proporcionados en esta sucursal.';

/**
 * Exige dos fechas de calendario reales, con inicio anterior o igual al fin. Un rango de un solo día es válido.
 */
const parseDateRange = (startDate?: string, endDate?: string): { startDate: string; endDate: string } => {
    const start = dateOnlySchema.safeParse(startDate);
    const end = dateOnlySchema.safeParse(endDate);

    // 'YYYY-MM-DD' se ordena igual como texto que como fecha
    if (!start.success || !end.success || start.data > end.data) {
        throw new ApiError(ApiErrorCode.BAD_REQUEST, REPORT_INVALID_RANGE_MESSAGE);
    }
    return { startDate: start.data, endDate: end.data };
};

/** Minúsculas, sin acentos y con espacios simples, para que "jose" encuentre a "José". */
const normalizeName = (value: string): string =>
    value
        .toLowerCase()
        .normalize('NFD')
        .replace(/\p{Diacritic}/gu, '')
        .trim()
        .replace(/\s+/g, ' ');

/**
 * La búsqueda coincide al inicio de cualquier palabra del nombre: "juan" o "carlos" encuentran a "Juan Carlos",
 * pero "ana" no encuentra a "Mariana". Una búsqueda vacía coincide con todos.
 */
const matchesName = (name: string, query: string = ''): boolean =>
    ` ${normalizeName(name)}`.includes(` ${normalizeName(query)}`);

/** Un barbero dado de baja solo aparece si tuvo citas en el rango; uno activo aparece siempre. */
const isReportable = (row: BarberPerformance): boolean => row.deleted_at === null || row.scheduled_appointments > 0;

/**
 * Genera el reporte de desempeño de uno o varios barberos de una sucursal (CU-49).
 * Requiere rol de manager, cuenta activa y que la sucursal esté a su cargo. Una sucursal inexistente responde
 * igual que una ajena, para no revelar cuáles existen.
 */
export const generateBarberPerformanceReport = async (
    data: BarberPerformanceReportRequest,
    token: string
): Promise<BarberPerformanceReportResponse> => {
    const performer = await isUserSessionValid(token);

    if (!canGenerateReports(performer)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to generate reports');
    }

    const managedShopIds = await getShopIdsByManagerId(performer.id);
    const shop = canGenerateShopReports(data.shopId, managedShopIds) ? await getShopById(data.shopId) : null;
    if (!shop) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, REPORT_SHOP_FORBIDDEN_MESSAGE);
    }

    const { startDate, endDate } = parseDateRange(data.startDate, data.endDate);

    const performance = await getBarberPerformance({
        shopId: shop.id,
        managedShopIds,
        startDate,
        endDate,
        timeZone: getBusinessTimezone(),
    });

    const matches = performance.filter(
        (row) => matchesName(row.first_name, data.firstName) && matchesName(row.last_name, data.lastName)
    );
    const isSearchingByName = Boolean(data.firstName || data.lastName);
    if (isSearchingByName && matches.length === 0) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, REPORT_BARBER_NOT_FOUND_MESSAGE);
    }

    const evaluated = matches.filter(isReportable);
    const totals = toPerformanceTotals(evaluated);
    if (totals.completedServices === 0) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, REPORT_NO_DATA_MESSAGE);
    }

    return {
        shopId: shop.id,
        shopName: shop.name,
        startDate,
        endDate,
        totals,
        barbers: evaluated.map(toBarberPerformanceResponse),
    };
};
</file>

<file path="backend/src/services/userService.ts">
import bcrypt from 'bcrypt';
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import { decodeToken } from './jwtTokenService.js';
import { canUpdateUser } from './userPermissions.js';
import {
    getUserRoleById,
    isUserActive,
    updateUserById,
    hardDeleteClient,
    softDeleteStaff,
} from '../repositories/userRepository.js';
import type { UpdateUserInput } from '../repositories/userRepository.js';
import { getManagerByUserId } from '../repositories/managerRepository.js';
import { getReceptionistByUserId } from '../repositories/receptionistRepository.js';
import { getClientByUserId } from '../repositories/clientRepository.js';
import type { User } from '../types/entities/user.interface.js';
import type { UserResponse } from '../types/dto/userResponse.interface.js';
import type { ProfileResponse } from '../types/dto/authResponse.interface.js';
import { toUserResponse, toManagerProfile, toReceptionistProfile, toClientProfile } from '../utils/userMapper.js';
import { calculateAgeFromDateOnly as calculateAge } from '../utils/dateOnly.js';

const MANAGER_HAS_SHOPS_ERROR_CODE = 'BM001';

/**
 * Actualiza los datos compartidos (tabla users) del usuario objetivo, siempre que
 * el usuario autenticado por el token esté autorizado a hacerlo (ver userPermissions.ts).
 */
const updateUser = async (user: UpdateUserInput, token: string): Promise<UserResponse> => {
    const performer = decodeToken(token);

    const target = await getUserRoleById(user.id);
    if (!target) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'User not found');
    }

    if (!canUpdateUser(performer, target)) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Not authorized to update this user');
    }

    // Rechaza un token que aún es válido cuyo propietario (o destinatario) fue desactivado desde que fue emitido.
    if (!(await isUserActive(performer.id)) || !(await isUserActive(target.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const fields: UpdateUserInput = { ...user };
    if (fields.password) {
        fields.password = await bcrypt.hash(fields.password, 10);
    }

    const updated = await updateUserById(fields);
    return toUserResponse(updated);
};

/**
 * Obtiene los datos específicos del rol de un usuario (manager, recepcionista o
 * cliente) para complementar los datos compartidos de `users`. Los barberos no
 * tienen cuenta de usuario, así que nunca pasan por aquí.
 */
const getUserProfile = async (user: User): Promise<ProfileResponse> => {
    switch (user.role) {
        case 'manager': {
            const manager = await getManagerByUserId(user.id);
            if (!manager) {
                throw new ApiError(ApiErrorCode.NOT_FOUND, 'Manager profile not found');
            }
            return toManagerProfile(manager);
        }
        case 'receptionist': {
            const receptionist = await getReceptionistByUserId(user.id);
            if (!receptionist) {
                throw new ApiError(ApiErrorCode.NOT_FOUND, 'Receptionist profile not found');
            }
            return toReceptionistProfile(receptionist);
        }
        case 'client': {
            const client = await getClientByUserId(user.id);
            if (!client) {
                throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client profile not found');
            }
            return toClientProfile(client);
        }
    }
};

/**
 * Maneja la lógica de negocio para eliminar un usuario.
 * Aplica discriminación por roles para permitir o denegar la acción,
 * y decide entre borrado físico o lógico según el rol del usuario objetivo.
 */
const deleteUserById = async (targetId: string, token: string): Promise<void> => {
    // Decodifica el token para identificar al usuario que realiza la petición
    const actor = decodeToken(token);

    // Obtiene el rol del usuario que se intentará eliminar
    const targetUser = await getUserRoleById(targetId);
    if (!targetUser) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'User not found');
    }

    // Identificadores de autorización
    const isSelf = actor.id === targetId;
    const isManager = actor.role === 'manager';

    // Lógica de autorización: discriminación por roles
    if (!isSelf) {
        if (!isManager) {
            // Si no es el mismo usuario y no es un mánager, se deniega el acceso
            throw new ApiError(ApiErrorCode.FORBIDDEN, 'Forbidden: You do not have permission to delete this account');
        } else if (targetUser.role === 'manager') {
            // Un mánager no puede eliminar a otro mánager
            throw new ApiError(ApiErrorCode.FORBIDDEN, 'Forbidden: Managers cannot delete other managers');
        }
    }

    // Ejecuta el borrado correspondiente
    if (targetUser.role === 'client') {
        // Borrado físico: el ON DELETE CASCADE eliminará el registro en la tabla 'clients'
        await hardDeleteClient(targetId);
    } else {
        // Borrado lógico: marca el campo 'deleted_at' del miembro del staff
        try {
            await softDeleteStaff(targetId, targetUser.role);
        } catch (error: unknown) {
            // SQLSTATE personalizado lanzado por check_manager_deletable() (init_database.sql)
            if ((error as { code?: string }).code === MANAGER_HAS_SHOPS_ERROR_CODE) {
                throw new ApiError(
                    ApiErrorCode.CONFLICT,
                    'Cannot delete manager because they still have shops assigned'
                );
            }
            throw error;
        }
    }
};

export { calculateAge, updateUser, getUserProfile, deleteUserById };
</file>


    suggestionText?: string;
    reasoning: string;
    confidence?: number;
}

interface InternalAIResponse<T> {
    data?: T;
    message: string;
    errors?: AIContentError[];
}

type AIContentError = {
    field?: string;
    detail: string;
};

export type {
    InternalAIRequest,
    InternalAIFaceDetectionRequest,
    InternalAIFaceDetectionResponse,
    InternalAIRecommendationRequest,
    InternalAIRecommendationResponse,
    InternalAIResponse,

<file path="backend/src/repositories/recommendationHistoryRepository.ts">
import db from '../connection/connection.js';
import type { RecommendationHistory } from '../types/entities/recommendationHistory.interface.js';

export interface CreateRecommendationHistoryParams {
    clientId: string;
    suggestionText?: string | null;
    /** Porcentaje (0-100) con dos decimales, como lo almacena la columna `numeric(5,2)`. */
    confidence?: number | null;
    reasoning?: string | null;
    /** IDs de los cortes recomendados, en el orden en que los devolvió la IA (el primero es el mejor). */
    recommendedHaircutStyleIds?: string[];
    errorMessage?: string | null;
    requestedAt: Date;
    completedAt: Date;
}

/**
 * Guarda en el historial el resultado de una solicitud de recomendación: una recomendación, un
 * "ningún corte aplica" o un error. Los campos que no aplican al resultado se guardan como NULL, y los cortes
 * recomendados se guardan en `recommendation_history_haircut_styles` dentro de la misma transacción.
 */
export const createRecommendationHistory = async ({
    clientId,
    suggestionText = null,
    confidence = null,
    reasoning = null,
    recommendedHaircutStyleIds = [],
    errorMessage = null,
    requestedAt,
    completedAt,
}: CreateRecommendationHistoryParams): Promise<RecommendationHistory> => {
    const pool = db.getPool();
    const client = await pool.connect();

    try {
        await client.query('BEGIN');

        const result = await client.query(
            `INSERT INTO recommendation_history
                (client_id, suggestion_text, confidence, reasoning, error_message, requested_at, completed_at)
             VALUES ($1, $2, $3, $4, $5, $6, $7)
             RETURNING *`,
            [clientId, suggestionText, confidence, reasoning, errorMessage, requestedAt, completedAt]
        );
        const history = result.rows[0] as RecommendationHistory;

        // Un mismo corte no puede aparecer dos veces en una recomendación (llave primaria de la tabla de unión).
        const haircutStyleIds = [...new Set(recommendedHaircutStyleIds)];

        if (haircutStyleIds.length > 0) {
            await client.query(
                `INSERT INTO recommendation_history_haircut_styles (recommendation_history_id, haircut_style_id, position)
                 SELECT $1, t.haircut_style_id, t.ord - 1
                 FROM unnest($2::uuid[]) WITH ORDINALITY AS t(haircut_style_id, ord)`,
                [history.id, haircutStyleIds]
            );
        }

        await client.query('COMMIT');
        return history;
    } catch (error) {
        await client.query('ROLLBACK');
        throw error;
    } finally {
        client.release();
    }
};

export type RecommendationHistoryWithHaircuts = RecommendationHistory & {
    /** Cortes recomendados en el orden de la IA; vacío si no se recomendó ninguno o todos fueron eliminados. */
    recommended_haircuts: { id: string; name: string }[];
};

/**
 * Historial de recomendaciones de un cliente, de la más reciente a la más antigua, con los cortes recomendados
 * (arreglo vacío si la solicitud no recomendó ninguno o los cortes fueron eliminados). Excluye las solicitudes que
 * fallaron (las que tienen `error_message`): solo incluye recomendaciones y "ningún corte aplica".
 */
export const getRecommendationHistoryByClientId = async (
    clientId: string
): Promise<RecommendationHistoryWithHaircuts[]> => {
    const pool = db.getPool();

    const result = await pool.query(
        `SELECT rh.*,
                COALESCE(
                    (SELECT json_agg(json_build_object('id', hs.id, 'name', hs.name) ORDER BY rhs.position)
                     FROM recommendation_history_haircut_styles rhs
                     JOIN haircut_styles hs ON hs.id = rhs.haircut_style_id
                     WHERE rhs.recommendation_history_id = rh.id),
                    '[]'::json
                ) AS recommended_haircuts
         FROM recommendation_history rh
         WHERE rh.client_id = $1 AND rh.error_message IS NULL
         ORDER BY rh.requested_at DESC`,
        [clientId]
    );

    return result.rows as RecommendationHistoryWithHaircuts[];
};
</file>

<file path="backend/src/repositories/reportRepository.ts">
import db from '../connection/connection.js';
import type { BarberPerformance } from '../types/entities/barberPerformance.interface.js';

export interface BarberPerformanceFilters {
    // Sucursal donde se agendaron las citas que se evalúan.
    shopId: string;
    // Sucursales del gerente: solo se devuelven barberos asignados a alguna de ellas.
    managedShopIds: string[];
    // Fechas de calendario 'YYYY-MM-DD', ambas inclusivas, interpretadas en timeZone.
    startDate: string;
    endDate: string;
    timeZone: string;
}

/**
 * Conteos de citas y servicios por barbero en una sucursal y un rango de fechas.
 *
 * - Cada cita cuenta en el día de su inicio programado (scheduled_start), igual para agendadas y finalizadas,
 *   de modo que ambos conteos salgan de las mismas citas.
 * - "Agendado" es toda cita registrada en el rango, sin importar su estado; "finalizado" es status = 'completed'.
 * - Devuelve a los barberos asignados a la sucursal (incluidos los dados de baja) y a los que tienen citas en
 *   ella dentro del rango aunque después se les haya reasignado a otra sucursal del mismo gerente.
 */
export const getBarberPerformance = async (filters: BarberPerformanceFilters): Promise<BarberPerformance[]> => {
    const result = await db.getPool().query<BarberPerformance>(
        `WITH metrics AS (
             SELECT a.barber_id,
                    COUNT(DISTINCT a.id)::int                                         AS scheduled_appointments,
                    (COUNT(DISTINCT a.id) FILTER (WHERE a.status = 'completed'))::int AS completed_appointments,
                    COUNT(aps.id)::int                                                AS scheduled_services,
                    (COUNT(aps.id) FILTER (WHERE a.status = 'completed'))::int        AS completed_services,
                    (COUNT(aps.id) FILTER (WHERE a.status = 'cancelled'))::int        AS cancelled_services,
                    (COUNT(aps.id) FILTER (WHERE a.status = 'no_show'))::int          AS no_show_services
             FROM appointments a
             LEFT JOIN appointment_services aps ON aps.appointment_id = a.id
             WHERE a.shop_id = $1
               AND a.scheduled_start >= ($3::date)::timestamp AT TIME ZONE $5
               AND a.scheduled_start < ($4::date + 1)::timestamp AT TIME ZONE $5
             GROUP BY a.barber_id
         )
         SELECT b.id AS barber_id, b.first_name, b.last_name, b.email, b.deleted_at,
                s.id AS assigned_shop_id, s.name AS assigned_shop_name,
                COALESCE(m.scheduled_appointments, 0) AS scheduled_appointments,
                COALESCE(m.completed_appointments, 0) AS completed_appointments,
                COALESCE(m.scheduled_services, 0)     AS scheduled_services,
                COALESCE(m.completed_services, 0)     AS completed_services,
                COALESCE(m.cancelled_services, 0)     AS cancelled_services,
                COALESCE(m.no_show_services, 0)       AS no_show_services
         FROM barbers b
         JOIN shops s ON s.id = b.shop_id
         LEFT JOIN metrics m ON m.barber_id = b.id
         WHERE b.shop_id = ANY($2::uuid[])
           AND (b.shop_id = $1 OR m.barber_id IS NOT NULL)
         ORDER BY b.first_name ASC, b.last_name ASC, b.id ASC`,
        [filters.shopId, filters.managedShopIds, filters.startDate, filters.endDate, filters.timeZone]
    );
    return result.rows;
};
</file>


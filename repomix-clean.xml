import bcrypt from 'bcrypt';
import { ApiError, ApiErrorCode } from '../errors/ApiError.js';
import { decodeToken } from './jwtTokenService.js';
import { isUserActive } from '../repositories/userRepository.js';
import { hasPendingAppointmentsByClientId } from '../repositories/appointmentRepository.js';
import {
    createClient,
    getClientById,
    searchClients as searchClientsRepo,
    getAllClients,
    updateClientById,
    deleteClientById,
    updateClientTelegramId
} from '../repositories/clientRepository.js';
import type { FacialStructureType } from '../types/entities/client.interface.js';
import type { ClientDetailResponse } from '../types/dto/clientResponse.interface.js';
import { toClientDetailResponse } from '../utils/userMapper.js';
import { isUserSessionValid } from '../utils/userSession.js';
import { canCreateClient } from './userPermissions.js';
import type { ClientWithUser } from '../repositories/clientRepository.js';

export interface CreateClientDTO {
    firstName: string;
    lastName: string;
    email: string;
    password: string;
    phone?: string | null;
    birthDate: string;
    gender: string;
    facialStructureType?: FacialStructureType | null;
    completedServicesCount?: number;
}

export interface UpdateClientDTO {
    id: string;
    email?: string;
    phone?: string | null;
    password?: string;
    firstName?: string;
    lastName?: string;
    birthDate?: string;
    gender?: string;
    facialStructureType?: FacialStructureType | null;
    completedServicesCount?: number;
}

/**
 * Registra un nuevo cliente en el sistema.
 * Si se envía un token, se verifica que sea personal autorizado (manager o receptionist).
 * Si no se envía token, se permite el auto-registro.
 */
export const registerClient = async (data: CreateClientDTO, token: string): Promise<ClientDetailResponse> => {
    const performer = await isUserSessionValid(token);

    if (!canCreateClient({ id: performer.id, role: performer.role })) {
        throw new ApiError(
            ApiErrorCode.FORBIDDEN,
            'Only staff members can directly create client accounts. Create an account using the /register endpoint instead.'
        );
    }

    const password_hash = await bcrypt.hash(data.password, 10);

    const created = await createClient({
        email: data.email,
        phone: data.phone ?? null,
        password_hash,
        first_name: data.firstName,
        last_name: data.lastName,
        birth_date: data.birthDate,
        gender: data.gender,
        facial_structure_type: data.facialStructureType ?? null,
        completed_services_count: data.completedServicesCount ?? 0,
    });

    return toClientDetailResponse(created);
};

/**
 * Lista todos los clientes registrados.
 * Solo accesible para el personal (manager y receptionist).
 */
export const listClients = async (token: string): Promise<ClientDetailResponse[]> => {
    const actor = decodeToken(token);
    if (!(await isUserActive(actor.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    if (actor.role !== 'manager' && actor.role !== 'receptionist') {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Only staff can list clients');
    }

    const clients = await getAllClients();
    return clients.map(toClientDetailResponse);
};

/**
 * Obtiene los detalles de un cliente por su ID.
 * Un cliente solo puede ver su propio perfil; el personal puede ver el de cualquier cliente.
 */
export const getClientDetails = async (id: string, token: string): Promise<ClientDetailResponse> => {
    const actor = decodeToken(token);
    if (!(await isUserActive(actor.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const isSelf = actor.id === id;
    const isStaff = actor.role === 'manager' || actor.role === 'receptionist';

    if (!isSelf && !isStaff) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'You do not have permission to view this client');
    }

    const client = await getClientById(id);
    if (!client) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client not found');
    }

    return toClientDetailResponse(client);
};

/**
 * Busca clientes por coincidencia parcial en nombre, apellido o correo.
 * Solo accesible para el personal (manager y receptionist).
 */
export const searchClients = async (term: string, token: string): Promise<ClientDetailResponse[]> => {
    const actor = decodeToken(token);
    if (!(await isUserActive(actor.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    if (actor.role !== 'manager' && actor.role !== 'receptionist') {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'Only staff can search clients');
    }

    const clients = await searchClientsRepo(term);
    return clients.map(toClientDetailResponse);
};

/**
 * Actualiza los datos de un cliente.
 * Un cliente puede actualizar su propio perfil; el personal (manager y receptionist) puede actualizar cualquier cliente.
 * Solo el personal puede modificar 'completedServicesCount'.
 */
export const updateClient = async (fields: UpdateClientDTO, token: string): Promise<ClientDetailResponse> => {
    const actor = decodeToken(token);
    if (!(await isUserActive(actor.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const target = await getClientById(fields.id);
    if (!target) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client not found');
    }

    const isSelf = actor.id === fields.id;
    const isStaff = actor.role === 'manager' || actor.role === 'receptionist';

    if (!isSelf && !isStaff) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'You do not have permission to update this client');
    }

    if (!isStaff) {
        if (fields.completedServicesCount !== undefined) {
            throw new ApiError(ApiErrorCode.FORBIDDEN, 'Clients cannot modify completed services count');
        } else if (fields.facialStructureType !== undefined) {
            throw new ApiError(ApiErrorCode.FORBIDDEN, 'Clients cannot modify facial structure type');
        }
    }

    const updateData: UpdateClientDTO = { ...fields };
    if (updateData.password) {
        updateData.password = await bcrypt.hash(updateData.password, 10);
    }

    const updated = await updateClientById(updateData);
    return toClientDetailResponse(updated);
};

/**
 * Elimina físicamente a un cliente por su ID.
 * Un cliente puede eliminar su propia cuenta; los managers y recepcionistas pueden eliminar cualquier cuenta de cliente.
 * No se puede eliminar a un cliente con citas pendientes (scheduled, rescheduled o checked_in): responde 409.
 * La revisión abarca todas las sucursales y fechas, sin importar el alcance del solicitante.
 */
export const deleteClient = async (id: string, token: string): Promise<void> => {
    const actor = decodeToken(token);
    if (!(await isUserActive(actor.id))) {
        throw new ApiError(ApiErrorCode.ACCOUNT_DEACTIVATED, 'Account is deactivated');
    }

    const target = await getClientById(id);
    if (!target) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client not found');
    }

    const isSelf = actor.id === id;
    const isStaff = actor.role === 'manager' || actor.role === 'receptionist';

    if (!isSelf && !isStaff) {
        throw new ApiError(ApiErrorCode.FORBIDDEN, 'You do not have permission to delete this account');
    }

    if (await hasPendingAppointmentsByClientId(id)) {
        throw new ApiError(ApiErrorCode.CONFLICT, 'Cannot delete a client with pending appointments');
    }

    await deleteClientById(id);
};


/**
 * Vincula el chat_id de Telegram con la cuenta del cliente.
 * Invocado internamente por el listener del bot al recibir /start <clientId>.
 */
export const linkClientTelegram = async (clientId: string, telegramChatId: string): Promise<ClientWithUser> => {
    const client = await getClientById(clientId);
    if (!client) {
        throw new ApiError(ApiErrorCode.NOT_FOUND, 'Client not found');
    }

    const updated = await updateClientTelegramId(clientId, telegramChatId);
    if (!updated) {
        throw new ApiError(ApiErrorCode.INTERNAL_SERVER_ERROR, 'Could not link Telegram account');
    }

    return client;
};

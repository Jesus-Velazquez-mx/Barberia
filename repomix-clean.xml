 */
router.post('/receptionists', create);

/**
 * @swagger
 * /api/receptionists/{id}:
 *   put:
 *     summary: Actualiza los datos personales de un recepcionista
 *     tags: [Receptionists]
 *     security:
 *       - bearerAuth: []
 *     description: Modifica los datos personales de un recepcionista. Al menos un campo debe ser enviado. Requiere rol de 'manager' y que el recepcionista pertenezca a una sucursal que el gerente administra. (El cambio de sucursal o turno se maneja en un endpoint independiente).
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID de usuario del recepcionista a modificar.
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               firstName:
 *                 type: string
 *                 example: "Misato"
 *               lastName:
 *                 type: string
 *                 example: "Katsuragi"
 *               email:
 *                 type: string
 *                 example: "misato2@barberia.com"
 *               phone:
 *                 type: string
 *                 example: "1234567890"
 *               birthDate:
 *                 type: string
 *                 example: "1992-05-15"
 *               gender:
 *                 type: string
 *                 example: "female"
 *     responses:
 *       200:
 *         description: Recepcionista actualizado exitosamente.
 *       400:
 *         description: Error de validación (ej. ID inválido o cuerpo de petición vacío).
 *       401:
 *         description: No autorizado.
 *       403:
 *         description: Prohibido. Solo un manager puede editar recepcionistas y únicamente los de sus sucursales.
 *       404:
 *         description: No se encontró el recepcionista a actualizar.
 *       409:
 *         description: El correo o teléfono ya pertenece a otro usuario, o el recepcionista está dado de baja y requiere reactivación.
 *       500:
 *         description: Error interno del servidor.
 */
router.put('/receptionists/:id', update);

/**
 * @swagger
 * /api/receptionists/{id}/assignment:
 *   put:
 *     summary: Reasigna la sucursal y el turno de un recepcionista
 *     tags: [Receptionists]
 *     security:
 *       - bearerAuth: []
 *     description: Reasigna la sucursal y el turno de un recepcionista. Solo un manager puede ejecutarlo, y debe administrar tanto la sucursal de origen como la de destino. Falla con 409 si el recepcionista está dado de baja. Falla con 404 si la sucursal, el turno o el recepcionista no existen. Falla con 403 si el manager no administra alguna de las sucursales involucradas.
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID único de usuario del recepcionista a reasignar.
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - shopId
 *               - shiftId
 *             properties:
 *               shopId:
 *                 type: string
 *                 format: uuid
 *                 example: "660e8400-e29b-41d4-a716-446655440111"
 *               shiftId:
 *                 type: string
 *                 format: uuid
 *                 example: "770e8400-e29b-41d4-a716-446655440222"
 *     responses:
 *       200:
 *         description: Recepcionista reasignado exitosamente.
 *       400:
 *         description: Error de validación en los identificadores de sucursal o turno.
 *       401:
 *         description: No autorizado.
 *       403:
 *         description: Prohibido. Solo un manager puede reasignar recepcionistas y debe administrar ambas sucursales.
 *       404:
 *         description: No se encontró el recepcionista, la sucursal o el turno.
 *       409:
 *         description: Conflicto. El recepcionista está dado de baja.
 *       500:
 *         description: Error interno del servidor.
 */
router.put('/receptionists/:id/assignment', reassign);

/**
 * @swagger
 * /api/receptionists/{id}:
 *   delete:
 *     summary: Borrado lógico de un recepcionista (Baja)
 *     tags: [Receptionists]
 *     security:
 *       - bearerAuth: []
 *     description: Da de baja a un recepcionista registrando el timestamp en `deleted_at`; deja de poder iniciar sesión. Puede reactivarse registrándolo de nuevo con el mismo correo. Requiere rol de 'manager' y que el recepcionista pertenezca a una sucursal que el gerente administra.
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID de usuario del recepcionista a dar de baja.
 *     responses:
 *       200:
 *         description: Recepcionista dado de baja exitosamente.
 *       400:
 *         description: El formato del ID proporcionado no es válido.
 *       401:
 *         description: No autorizado.
 *       403:
 *         description: Prohibido. Solo un manager puede eliminar recepcionistas y únicamente los de sus sucursales.
 *       404:
 *         description: No se encontró el recepcionista a eliminar.
